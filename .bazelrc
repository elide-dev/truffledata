common --java_runtime_version=graalvm_25
common --tool_java_runtime_version=graalvm_25
common --java_language_version=25
common --tool_java_language_version=25
common --enable_bzlmod
common --repo_env=ANDROID_HOME=
common --repo_env=ANDROID_SDK_ROOT=
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --macos_minimum_os=12.0
build:macos --features=-macos_minimum_os
build:macos --host_features=-macos_minimum_os
# Optimize linked native dependencies as well as adapter sources (not just leaf rustc flags).
build --compilation_mode=opt
# Preserve dependency bitcode and run cross-crate Rust ThinLTO at static/shared library links.
build --@rules_rust//rust/toolchain/channel=nightly
build --@rules_rust//rust/settings:lto=thin
# Elide LLVM toolchains supply clang/lld and the Bazel ThinLTO backend tools.
build --features=thin_lto
build --incompatible_strict_action_env
build --nojava_header_compilation
build --experimental_java_classpath=off
build --@rules_go//go/config:pure
test --test_output=errors
test --nozip_undeclared_test_outputs
test --remote_download_regex=.*/testlogs/.*
# ---- BuildBuddy best practices (docs/BAZEL.md; after BuildBuddy's own shared.bazelrc).
# BLAKE3 digests: faster hashing of inputs (BuildBuddy's caches accept them).
startup --digest_function=BLAKE3
# Repository annotations on every invocation (repo URL, commit, branch, tree status).
common --enable_platform_specific_config
common:linux --workspace_status_command=$(pwd)/tools/workspace_status.sh
common:macos --workspace_status_command=$(pwd)/tools/workspace_status.sh
# Outputs per platform (switching between macOS and remote Linux builds wipes nothing), lost inputs recovered within the
# build, clickable timing profiles.
common --experimental_platform_in_output_dir
common --rewind_lost_inputs
common --experimental_profile_include_target_label
common --experimental_profile_include_primary_output
common --noslim_profile
# Hermetic C/C++: only elide-dev/toolchain, never an auto-detected host compiler.
common --repo_env=DO_NOT_TRACK=1
# Cache hits across configurations for actions that support path mapping (Java compiles across target/exec).
common --experimental_output_paths=strip

# The default for builds/tests is one Linux amd64 execution and cache profile, including on macOS.
# Supply the organization's API key in user.bazelrc; --config=local explicitly opts into host execution.
common --config=remote

# BuildBuddy (--config=buildbuddy): remote cache and build results. Authenticated only: the API key header
# (`common --remote_header=x-buildbuddy-api-key=<key>` in user.bazelrc or ~/.bazelrc; a secret in CI) keeps invocations
# private to the organization, so never enable this config without one.
common:buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
common:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
common:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
# Repository downloads through BuildBuddy's cache (the GraalVM, toolchain and Maven archives), else directly.
common:buildbuddy --experimental_remote_downloader=grpcs://remote.buildbuddy.io
common:buildbuddy --experimental_remote_downloader_local_fallback
common:buildbuddy --remote_cache_compression
common:buildbuddy --experimental_remote_cache_chunking
common:buildbuddy --remote_timeout=10m
# Cache namespace: bump the suffix to start from an empty cache.
common:buildbuddy --remote_instance_name=elide-dev/truffledata/v1
common:buildbuddy --build_metadata=REPO_NAME=truffledata
# Build without the bytes: only top-level outputs (and test results) come back.
common:buildbuddy --remote_download_toplevel
# Local results never enter the shared cache. RBE results come from the same Linux inputs on every client.
common:buildbuddy --noremote_upload_local_results
common:ci --build_metadata=ROLE=CI
# Correctness jobs need test results, not every wildcard target's distribution/jar/native outputs.
# Keep `build`/`run` downloads unchanged for jobs that package or execute their outputs locally.
test:ci --remote_download_minimal

# Remote execution (--config=remote, implies buildbuddy): every action on BuildBuddy's Linux executors in Firecracker
# microVMs from Komodo's builder image (//bazel/platforms:rbe_linux_amd64; .devcontainer/Dockerfile), with the build's own
# hermetic toolchains as inputs. Targets build for that platform; host-sensitive gates stay local (no-remote-exec).
common:remote --config=buildbuddy
common:remote --remote_executor=grpcs://remote.buildbuddy.io
common:remote --platforms=//bazel/platforms:rbe_linux_amd64
common:remote --host_platform=//bazel/platforms:rbe_linux_amd64
common:remote --jobs=100
common:remote --spawn_strategy=remote
common:remote --noremote_local_fallback
common:remote --experimental_inmemory_jdeps_files
common:remote --experimental_inmemory_dotd_files
common:remote --disk_cache=
# Tests and tools execute remotely: no local runfiles trees (they hold whole JDKs and fill small CI disks).
common:remote --nobuild_runfile_links
common:remote --verbose_failures
# The same remote profile on BuildBuddy's arm64 Linux executors: targets and execution are linux-aarch64
# (//bazel/platforms:rbe_linux_arm64), for the linux-aarch64 release natives and their tests.
common:remote_arm64 --config=remote
common:remote_arm64 --platforms=//bazel/platforms:rbe_linux_arm64
common:remote_arm64 --host_platform=//bazel/platforms:rbe_linux_arm64


# Nearby GCP execution; selected by trusted CI only after shared-cache setup succeeds.
# --config=remote retains hosted BuildBuddy execution; --config=local remains host-local.
common:shared_cache --remote_executor=grpcs://elide-dev.buildbuddy.io:443
common:shared_cache --platforms=//bazel/platforms:rbe_linux_amd64_shared
common:shared_cache --host_platform=//bazel/platforms:rbe_linux_amd64_shared

# Explicit host execution for performance measurements and workspace tools (bazel run). Never write host results to
# the remote cache: the macOS C/C++ wrapper selects a host SDK outside action keys.
common:local --remote_executor=
common:local --remote_cache=
common:local --bes_backend=
common:local --bes_results_url=
common:local --experimental_remote_downloader=
common:local --platforms=@bazel_tools//tools:host_platform
common:local --host_platform=@bazel_tools//tools:host_platform
common:local --spawn_strategy=worker,sandboxed,local
common:local --build_runfile_links
common:local --jobs=auto
common:local --noremote_upload_local_results
# BuildBuddy Workflows (buildbuddy.yaml) runs, tagged as CI.
common:workflows --build_metadata=ROLE=CI
test:workflows --remote_download_minimal
# Untrusted builds (pull requests holding a write-capable key): their own cache namespace, isolated from main's.
common:untrusted --remote_instance_name=elide-dev/truffledata/untrusted/v1

try-import %workspace%/user.bazelrc

# Instrument correctness tests only: probes change allocation and JIT graph budgets.
coverage:codecov --combined_report=lcov
coverage:codecov --instrumentation_filter=^//(core|jdbc|jdbc-sqlite|jdbc-mysql|jdbc-postgresql|protobuf|protobuf-runtime)(/|:),^//protobuf-buffa:protobuf-buffa$,^//json:(json|jvm)$,^//tape:(tape|jvm)$,^//yaml:(yaml|jvm|svm|java|snakeyaml)$,^//csv:csv$,^//bebop:bebop$,^//bebop/kernel:jvm$
coverage:codecov --test_tag_filters=-allocation,-jit
coverage:codecov --test_arg=--exclude-tag --test_arg=allocation
coverage:codecov --test_arg=--exclude-tag --test_arg=jit
coverage:codecov --remote_download_toplevel

# Static-only CSV release archives for Elide's musl targets; tools still run on GNU RBE hosts.
build:remote_musl --config=remote --dynamic_mode=off --platforms=//bazel/platforms:linux_amd64_musl
build:remote_arm64_musl --config=remote_arm64 --dynamic_mode=off --platforms=//bazel/platforms:linux_arm64_musl

# Native security tests: GNU Linux amd64 with the upstream instrumented libc++ add-on.
# Link one instrumented C++ runtime into each standalone test executable.
build:asan --dynamic_mode=off
build:asan --extra_toolchains=@elide_toolchain_asan//:asan
build:asan --copt=-fsanitize=address,undefined
build:asan --copt=-fno-sanitize-recover=all
build:asan --copt=-gline-tables-only
build:asan --linkopt=-fsanitize=address,undefined
test:asan --run_under=//tools/fuzz:run_wrapper
test:asan --test_env=ASAN_OPTIONS=detect_leaks=1:abort_on_error=1
test:asan --test_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
# Coverage instrumentation reaches parser dependencies, not only the harness TU.
build:fuzz --config=asan
build:fuzz --define=td_fuzz=1
build:fuzz --copt=-fsanitize=fuzzer-no-link
# Rust uses the same Clang ASan runtime as its C++ dependencies (no duplicate runtime).
build:asan-rust --config=asan
build:asan-rust --@rules_rust//rust/settings:extra_rustc_flags=-Zsanitizer=address,-Zexternal-clangrt
