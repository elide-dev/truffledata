+    /** Binary traversal excludes text duplicate/null/Any handling from the hot loop. */
+    private void consumeBinary(BuffaWire.Tape tape, int start, int end) {
+      for (int index = start; index < end; ) {
+        context.charge(1);
+        int at = index * Buffa.Field.SIZE;
+        int ordinal = tape.bytes.getInt(at + (int) BuffaFFM.Field_number_OFFSET) - 1;
+        int kind = tape.bytes.getInt(at + (int) BuffaFFM.Field_wire_OFFSET);
+        long value = tape.bytes.getLong(at + (int) BuffaFFM.Field_value_OFFSET);
+        int length = tape.bytes.getInt(at + (int) BuffaFFM.Field_length_OFFSET);
+        int next = tape.bytes.getInt(at + (int) BuffaFFM.Field_end_OFFSET);
+        if (ordinal < 0 || ordinal >= plan.size() || next <= index || next > end || length < 0)
+          throw new IllegalStateException("Invalid native typed index");
+        var f = plan.field(ordinal);
+        if (kind != f.kind().ordinal() + 1) throw new IllegalStateException("Native kind mismatch");
+        // A closed-enum map value can invalidate its entire entry in binary protobuf.
+        if (f.map() && length != 0) {
+          index = next;
+          continue;
+        }
+        if (f.kind() == ProtoPlan.Kind.BYTES) context.charge(length);
+        Object decoded;
+        if (f.kind().message()) {
+          if (!f.repeated()) select(ordinal);
+          State child =
+              !f.repeated() && values[ordinal] instanceof State old
+                  ? old
+                  : new State(
+                      plan.nested(ordinal),
+                      Objects.requireNonNull(hints.children[ordinal]),
+                      context);
+          child.consumeBinary(tape, index + 1, next);
+          decoded = child;
+        } else decoded = scalar(f, ordinal, value, length);
+        if (f.repeated()) {
+          Repeated items;
+          if (values[ordinal] instanceof Repeated existing) items = existing;
+          else {
+            items = new Repeated();
+            values[ordinal] = items;
+          }
+          items.add(decoded, tape, index, end, ordinal);
+        } else {
+          select(ordinal);
+          values[ordinal] = decoded;
+        }
+        present(ordinal, true);
+        index = next;
+      }
+    }
