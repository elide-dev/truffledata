+  // PROBE (not committed): per-sample process CPU, faults and run-queue delay from /proc.
+  static boolean TRACE;
+  static long[] lastTrace = new long[6];
+  static final Map<String, Long> VM = new java.util.HashMap<>();
+
+  static void trace(String label) {
+    try {
+      String stat = java.nio.file.Files.readString(Path.of("/proc/self/stat"));
+      String[] f = stat.substring(stat.lastIndexOf(')') + 2).split(" ");
+      // fields after ')' start at field 3 (state): minflt=10, majflt=12, utime=14, stime=15
+      long minflt = Long.parseLong(f[7]), majflt = Long.parseLong(f[9]);
+      long utime = Long.parseLong(f[11]), stime = Long.parseLong(f[12]);
+      String[] sched = java.nio.file.Files.readString(Path.of("/proc/thread-self/schedstat")).trim().split(" ");
+      long run = Long.parseLong(sched[0]), wait = Long.parseLong(sched[1]);
+      long thp = 0;
+      for (String line : java.nio.file.Files.readAllLines(Path.of("/proc/self/status")))
+        if (line.startsWith("VmRSS")) thp = Long.parseLong(line.replaceAll("[^0-9]", ""));
+      StringBuilder vm = new StringBuilder();
+      for (String line : java.nio.file.Files.readAllLines(Path.of("/proc/vmstat"))) {
+        String[] kv = line.split(" ");
+        if (kv[0].startsWith("numa_") || kv[0].startsWith("thp_fault") || kv[0].startsWith("compact_stall")
+            || kv[0].startsWith("pgmigrate_success") || kv[0].equals("pgfault") || kv[0].startsWith("pgscan")
+            || kv[0].startsWith("pgsteal") || kv[0].startsWith("pswp") || kv[0].startsWith("thp_split")) {
+          long v = Long.parseLong(kv[1]);
+          Long prev = VM.put(kv[0], v);
+          if (prev != null && v != prev) vm.append(' ').append(kv[0]).append('=').append(v - prev);
+        }
+      }
+      long[] now = {minflt, majflt, utime, stime, run, wait};
+      System.err.printf(Locale.ROOT, "TRACE %s minflt %d majflt %d utime_ticks %d stime_ticks %d thread_run_ms %.1f thread_wait_ms %.1f rss_kb %d vm%s%n",
+          label, now[0] - lastTrace[0], now[1] - lastTrace[1], now[2] - lastTrace[2], now[3] - lastTrace[3],
+          (now[4] - lastTrace[4]) / 1e6, (now[5] - lastTrace[5]) / 1e6, thp, vm);
+      lastTrace = now;
+    } catch (Exception e) {
+      System.err.println("TRACE unavailable " + e);
+    }
+  }
