load("@rules_graalvm//graalvm:defs.bzl", "native_image")
load("@rules_java//java:defs.bzl", "java_binary", "java_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:java.bzl", "data_java_library")
load("//bazel:jit.bzl", "TRUFFLE_JIT_CHECKS")
load("//bazel:simulation.bzl", "simulation_image")

package(default_visibility = ["//visibility:public"])

data_java_library(
    name = "benchmarks",
    srcs = [
        "src/main/java/dev/elide/truffledata/bench/BenchmarkLanguage.java",
        "src/main/java/dev/elide/truffledata/bench/JdbcFixture.java",
        "src/main/java/dev/elide/truffledata/bench/JitMatrix.java",
        "src/main/java/dev/elide/truffledata/bench/NativeHooks.java",
        "src/main/java/dev/elide/truffledata/bench/ReadBenchmark.java",
        "src/main/java/dev/elide/truffledata/bench/SimulationBenchmark.java",
        "src/main/java/dev/elide/truffledata/bench/package-info.java",
    ],
    plugins = ["//bazel:jmh_processor"],
    deps = [
        "//benchmarks/comparison:json_fixture",
        "//benchmarks/comparison:yaml_fixture",
        "//benchmarks/fixtures:contracts",
        "//core",
        "//jdbc",
        "//json",
        "//protobuf",
        "//yaml",
        "@maven//:com_google_code_gson_gson",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:org_graalvm_polyglot_polyglot",
        "@maven//:org_graalvm_sdk_nativeimage",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_openjdk_jmh_jmh_core",
    ],
)

java_binary(
    name = "jmh",
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    main_class = "org.openjdk.jmh.Main",
    tags = ["manual"],
    runtime_deps = [
        ":benchmarks",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

exports_files(["BUILD.bazel"])

filegroup(
    name = "sources",
    srcs = glob(["src/**/*.java"]),
)

java_test(
    name = "smoke",
    args = [
        "ReadBenchmark",
        "-wi",
        "1",
        "-i",
        "1",
        "-w",
        "100ms",
        "-r",
        "100ms",
        "-f",
        "0",
        "-prof",
        "gc",
    ],
    jvm_flags = [
        "--enable-native-access=ALL-UNNAMED",
        "-Dpolyglot.engine.WarnInterpreterOnly=false",
    ],
    main_class = "org.openjdk.jmh.Main",
    tags = [
        "benchmark",
        "manual",
    ],
    use_testrunner = False,
    runtime_deps = [
        ":benchmarks",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

# Native Image and the C hooks are built remotely; simulation runs on the CI client.
java_test(
    name = "simulation_smoke",
    args = ["--smoke"],
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    main_class = "dev.elide.truffledata.bench.SimulationBenchmark",
    use_testrunner = False,
    runtime_deps = [
        ":benchmarks",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

genrule(
    name = "protobuf_reflection",
    outs = ["protobuf-reflect-config.json"],
    cmd = "$(location //protobuf:native_metadata) com.google.protobuf.Type > $@",
    tools = ["//protobuf:native_metadata"],
)

native_image(
    name = "native",
    cc_deps = [
        "//benchmarks/native:hooks",
        "//json/native:svm",
        "//yaml/native:svm",
    ],
    data = [
        "proxy-config.json",
        ":protobuf_reflection",
        "//benchmarks/native:databench.h",
    ],
    debug = True,
    exec_properties = {
        "EstimatedCPU": "8",
        "EstimatedMemory": "24GB",
        "EstimatedFreeDiskBytes": "16GB",
    },
    executable_name = "truffledata-bench",
    extra_args = [
        "--gc=serial",
        # Library static state is immutable schema/sentinel/DSL metadata. Workloads and sinks stay runtime-owned.
        "--initialize-at-build-time=dev.elide.truffledata",
        "--initialize-at-run-time=dev.elide.truffledata.bench.SimulationBenchmark",
        "--initialize-at-build-time=dev.elide.truffledata.bench.BenchmarkLanguageProvider",
        "--parallelism=8",
        "-march=compatibility",
        "-H:+UnlockExperimentalVMOptions",
        "-H:-DeleteLocalSymbols",
        "-H:+PreserveFramePointer",
        "-H:DynamicProxyConfigurationFiles=benchmarks/proxy-config.json",
        "-H:ReflectionConfigurationFiles=$(location :protobuf_reflection)",
        "-H:+PrintRuntimeCompileMethods",
    ] + TRUFFLE_JIT_CHECKS + [
        "-H:-UnlockExperimentalVMOptions",
    ],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    main_class = "dev.elide.truffledata.bench.SimulationBenchmark",
    optimization_mode = "3",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    workspace_tmp = True,
    deps = [
        ":benchmarks",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

simulation_image(
    name = "simulation",
    image = ":native",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

filegroup(
    name = "native_debug",
    srcs = [":native"],
    output_group = "debug_files",
    tags = ["manual"],
)

exports_files(["cases.json"])

sh_test(
    name = "native_smoke",
    srcs = ["native_smoke.sh"],
    args = ["$(rootpath :simulation)"],
    data = [":simulation"],
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
