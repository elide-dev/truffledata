# WS11 probe seam (plan 2026-11-08-beat-stock-svm §4): the production buffa.seam with Myna Truffle
# cells enabled, generated into a benchmark-only package. The declarations are byte-identical to
# ../../../protobuf-buffa/native/buffa.seam; only the module options differ, so the generated
# BuffaCells binding equals the shipped Buffa binding except for its ABI fingerprint, and its Rust
# output is unused (the shipped static archive exports the symbols). Regenerate the import block
# from the production seam whenever that file changes; the shipped bindings do not enable cells.
module truffledata_buffa abi=12 target=x86_64-unknown-linux-gnu java_package=dev.elide.truffledata.comparison.cells.generated java_class=BuffaCells truffle_cells=true truffle_backend=native truffle_transitions=direct c_library=truffledata_buffa c_library_static=true
# The integer protocol of every entry below (protobuf-buffa/native/lib.rs, slab.rs, typed*.rs). The
# Rust provider uses the generated consts and newtypes; Java uses BuffaConstants.
enum Status type=i32
  value ok = 0
  value malformed = 1
  value budget = 2
  value allocation = 3
  value panic = 4
  value needs_capacity = 6
end
# typed/typedReuse `format`.
enum Format type=u32
  value binary = 0
  value text = 1
  value json = 2
end
# decodeSlab(Small) `flags`: exactly one of owning or borrowing, plus optional lax and sizing_only.
flags DecodeFlags type=u32
  bit owning = 0
  bit lax = 1
  bit sizing_only = 2
  bit borrowing = 3
end
# SlabResult.flags: the slab header flags (docs/SLAB.md; protobuf-runtime SlabFormat).
flags SlabFlags type=u32
  bit owning = 0
  bit borrowing = 1
  bit lax = 2
  bit certified = 3
  bit projected = 4
end
# Field.wire of a decode index: the protobuf wire type. A typed index stores there the TDB3 field
# kind (ProtoPlan.Kind ordinal + 1) or one of the TYPED_ markers instead, so the field carries no
# enum= reference.
enum WireType type=u32
  value varint = 0
  value fixed64 = 1
  value length_delimited = 2
  value start_group = 3
  value end_group = 4
  value fixed32 = 5
end
# Typed-index markers in Field.wire: a JSON null, a JSON map/list field occurrence, an Any payload.
const TYPED_NULL type=u32 value=0
const TYPED_FIELD_MARKER type=u32 value=100
const TYPED_ANY type=u32 value=101
# Deepest nesting any entry accepts (max_depth).
const MAX_DEPTH type=u32 value=128
# decodeSlabSmall bound on input length and output capacity.
const SMALL_LIMIT type=u64 value=65536
# A compiled schema program (compileLayout); released by releaseLayout.
opaque Layout
struct Field size=24 align=8
  field number type=u32 offset=0
  field wire type=u32 offset=4
  field value type=u64 offset=8
  field length type=u32 offset=16
  field end type=u32 offset=20
end
# An owned field index: `count` Fields (capacity: the allocation's, for release).
struct Result size=24 align=8
  field data type=ptr<Field> offset=0 count=count
  field count type=u64 offset=8
  field capacity type=u64 offset=16
end
# compileLayout's result: the owned handle and its number of types (capacity is always 0).
struct LayoutResult size=24 align=8
  field data type=ptr<Layout> offset=0
  field count type=u64 offset=8
  field capacity type=u64 offset=16
end
import fingerprint symbol=td_buffa_fingerprint return=ptr<u8> error=no_failure native_leaf=true@explicit_contract
end
import decode symbol=td_buffa_decode return=i32 enum=Status error=no_failure native_leaf=false@explicit_contract
  param data type=ptr<u8> nullable=false ownership=borrowed access=read
  param length type=u64
  param max_cells type=u64
  param max_depth type=u32
  param max_native_bytes type=u64
  param result type=ptr<Result> nullable=false ownership=borrowed access=write
end
import release symbol=td_buffa_release return=void error=no_failure native_leaf=false@explicit_contract
  param result type=ptr<Result> nullable=false ownership=borrowed access=read_write
end
import typed symbol=td_buffa_typed return=i32 enum=Status error=no_failure native_leaf=false@explicit_contract
  param schema type=ptr<u8> nullable=false ownership=borrowed access=read
  param schema_length type=u64
  param data type=ptr<u8> nullable=false ownership=borrowed access=read
  param length type=u64
  param format type=u32 enum=Format
  param payload type=ptr<u8> nullable=false ownership=borrowed access=write
  param payload_length type=u64
  param max_cells type=u64
  param max_string_bytes type=u64
  param max_depth type=u32
  param max_native_bytes type=u64
  param result type=ptr<Result> nullable=false ownership=borrowed access=write
end
import typedReuse symbol=td_buffa_typed_reuse return=i32 enum=Status error=no_failure native_leaf=false@explicit_contract
  param schema type=ptr<u8> nullable=false ownership=borrowed access=read
  param schema_length type=u64
  param data type=ptr<u8> nullable=false ownership=borrowed access=read
  param length type=u64
  param format type=u32 enum=Format
  param payload type=ptr<u8> nullable=false ownership=borrowed access=write
  param payload_length type=u64
  param max_cells type=u64
  param max_string_bytes type=u64
  param max_depth type=u32
  param max_native_bytes type=u64
  param result type=ptr<Result> nullable=false ownership=borrowed access=read_write
end
import utf8_to_utf16 symbol=td_buffa_utf8_to_utf16 return=i64 error=no_failure native_leaf=false@explicit_contract
  param data type=ptr<u8> nullable=false ownership=borrowed access=read
  param length type=u64
  param output type=ptr<u16> nullable=false ownership=borrowed access=write
  param capacity type=u64
end
struct SlabResult size=32 align=8
  field bytes type=u64 offset=0
  field records type=u32 offset=8
  field handles type=u32 offset=12
  field flags type=u32 offset=16 flags=SlabFlags
  field error type=u32 offset=20
  field cells type=u32 offset=24
  field string_bytes type=u32 offset=28
end
import compileLayout symbol=td_buffa_compile_layout return=i32 enum=Status error=no_failure native_leaf=false@explicit_contract
  param schema type=ptr<u8> nullable=false ownership=borrowed access=read
  param schema_length type=u64
  param result type=ptr<LayoutResult> nullable=false ownership=borrowed access=write
end
import releaseLayout symbol=td_buffa_release_layout return=void error=no_failure native_leaf=false@explicit_contract
  param compiled type=ptr<Layout> nullable=true ownership=borrowed access=read_write
end
import decodeSlab symbol=td_buffa_decode_slab return=i32 enum=Status error=no_failure native_leaf=false@explicit_contract
  param compiled type=ptr<Layout> nullable=false ownership=borrowed access=read
  param data type=ptr<u8> nullable=false ownership=borrowed access=read
  param length type=u64
  param flags type=u32 flags=DecodeFlags
  param projection type=ptr<u8> nullable=true ownership=borrowed access=read
  param out type=ptr<u8> nullable=true ownership=borrowed access=write
  param capacity type=u64
  param max_depth type=u32
  param max_slab_bytes type=u64
  param result type=ptr<SlabResult> nullable=false ownership=borrowed access=write
end
import decodeSlabSmall symbol=td_buffa_decode_slab_small return=i32 enum=Status error=no_failure native_leaf=true@explicit_contract
  param compiled type=ptr<Layout> nullable=false ownership=borrowed access=read
  param data type=ptr<u8> nullable=false ownership=borrowed access=read
  param length type=u64
  param flags type=u32 flags=DecodeFlags
  param projection type=ptr<u8> nullable=true ownership=borrowed access=read
  param out type=ptr<u8> nullable=true ownership=borrowed access=write
  param capacity type=u64
  param max_depth type=u32
  param max_slab_bytes type=u64
  param result type=ptr<SlabResult> nullable=false ownership=borrowed access=write
end
