# Fresh-process measurements with raw samples, one shard per (dataset, size) plus a size sweep for
# kernel crossovers; each shard also runs the native probes on its own worker.
[
    sh_test(
        name = name,
        size = "enormous",
        srcs = ["csv_measure.sh"],
        args = [
            runtime,
            "$(rootpath %s)" % binary,
            "$(rootpath :csv_fixture)",
            "$(rootpath :csv_probe)",
            "$(rootpath :csv_probe_rs)",
        ],
        data = [
            "csv_measure.py",
            binary,
            ":csv_fixture",
            ":csv_probe",
            ":csv_probe_rs",
        ],
        exec_properties = {
            "EstimatedCPU": "4",
            "EstimatedMemory": "16GB",
        },
        shard_count = 9,
        tags = [
            "benchmark",
            "manual",
        ],
        target_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ],
    )
    for name, runtime, binary in [
        ("csv_measure", "svm", ":csv_svm"),
        ("csv_measure_v3", "svm", ":csv_svm_v3"),
        ("csv_measure_jvm", "jvm", ":csv_jvm"),
    ]
]


