# ---- CSV comparison (benchmarks/comparison/CSV.md). Competitors are benchmark-only dependencies.

# Benchmark-only access to package-private CSV internals (the strict scanner, UTF-8 validator and
# number parsers); never part of a published artifact.
data_java_library(
    name = "csv_bench",
    testonly = True,
    srcs = ["csv/CsvBench.java"],
    deps = ["//csv"],
)

CSV_COMPETITORS = [
    "@maven//:com_fasterxml_jackson_core_jackson_core",
    "@maven//:com_fasterxml_jackson_dataformat_jackson_dataformat_csv",
    "@maven//:com_univocity_univocity_parsers",
    "@maven//:de_siegmar_fastcsv",
    "@maven//:org_apache_commons_commons_csv",
]

data_java_library(
    name = "csv_comparison",
    testonly = True,
    srcs = [
        "ComparisonLanguage.java",
        "CsvComparison.java",
        "CsvFixture.java",
    ],
    deps = CSV_COMPETITORS + [
        ":csv_bench",
        "//core",
        "//csv",
        "//csv/kernel",
        "//csv/kernel:vector",
        "@maven//:org_graalvm_polyglot_polyglot",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

data_java_library(
    name = "csv_comparison_svm",
    testonly = True,
    srcs = ["CsvComparisonSvm.java"],
    deps = [
        ":csv_comparison",
        "//csv/kernel",
        "//csv/kernel:svm",
    ],
)

data_java_library(
    name = "csv_comparison_jvm",
    testonly = True,
    srcs = ["CsvComparisonJvm.java"],
    deps = [
        ":csv_comparison",
        "//csv/kernel",
        "//csv/kernel:jvm",
    ],
)

CSV_SVM_ARGS = [
    "--gc=serial",
    "--parallelism=8",
    "--add-modules=jdk.incubator.vector",
    "--initialize-at-build-time=dev.elide.truffledata",
    # Competitor singletons, and the vector species chosen for the CPU that runs the image.
    "--initialize-at-run-time=dev.elide.truffledata.comparison.CsvComparison$$Competitors",
    "--initialize-at-run-time=dev.elide.truffledata.csv.kernel.vector.VectorIndexer",
    "--add-exports=org.graalvm.truffle.runtime/com.oracle.truffle.runtime=ALL-UNNAMED",
    "-H:+UnlockExperimentalVMOptions",
] + TRUFFLE_JIT_CHECKS + ["-H:-UnlockExperimentalVMOptions"]

# The repository's portable image (-march=compatibility) and a variant for x86-64-v3 hosts, where
# Java code may use AVX2, BMI2, POPCNT and LZCNT (the Java kernels' bit operations depend on it).
[
    native_image(
        name = name,
        testonly = True,
        cc_deps = ["//csv/native:truffledata_csv"],
        exec_properties = {
            "EstimatedCPU": "8",
            "EstimatedMemory": "24GB",
        },
        executable_name = executable,
        extra_args = CSV_SVM_ARGS + [march],
        graalvm_sdk = "@graalvm_linux_amd64//:gvm",
        main_class = "dev.elide.truffledata.comparison.CsvComparisonSvm",
        optimization_mode = "2",
        tags = ["manual"],
        target_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ],
        deps = [":csv_comparison_svm"],
    )
    for name, executable, march in [
        ("csv_svm", "csv-comparison", "-march=compatibility"),
        ("csv_svm_v3", "csv-comparison-v3", "-march=x86-64-v3"),
    ]
]

CSV_JVM_FLAGS = [
    "--add-modules=jdk.incubator.vector",
    "--enable-native-access=ALL-UNNAMED",
]

java_binary(
    name = "csv_jvm",
    testonly = True,
    data = ["//csv/native:csv_shared.so"],
    # A fixed, pre-touched heap: on the RBE guests a first-touch page fault intermittently costs
    # about 40 us instead of about 1 us, so heap growth inside a timed sample made allocating
    # cells bimodal (benchmarks/results/csv-720f0c7/README.md; CSV ledger).
    jvm_flags = CSV_JVM_FLAGS + [
        "-Xms8g",
        "-Xmx8g",
        "-XX:+AlwaysPreTouch",
    ],
    main_class = "dev.elide.truffledata.comparison.CsvComparisonJvm",
    runtime_deps = [":csv_comparison_jvm"],
)

# JVM smoke: every engine on every fixture; checksums must agree within a workload.
