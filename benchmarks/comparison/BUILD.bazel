# The repository's portable image (-march=compatibility), and an x86-64-v3 variant for the JSON
# scoreboard (simdjson-java needs 256-bit vector species; every engine shares that image's flags).
[
    native_image(
        # Keep JsonComparison build-time initialized: its static helpers must be JIT eligible.
        name = name,
        testonly = True,
        cc_deps = ["//json/native:svm"],
        exec_properties = {
            "EstimatedCPU": "8",
            "EstimatedMemory": "24GB",
        },
        executable_name = executable,
        extra_args = [
            "--gc=serial",
            "--parallelism=8",
            march,
            # simdjson-java (a JSON competitor) uses the Vector API; competitor singletons and the
            # vector species are chosen at run time on the measuring CPU.
            "--add-modules=jdk.incubator.vector",
            "--initialize-at-build-time=dev.elide.truffledata",
            "--initialize-at-run-time=dev.elide.truffledata.comparison.JsonCompetitors",
            # fastjson2's own native-image.properties initializes its core classes at build time,
            # which puts instances of its other classes in the image heap: initialize all of it.
            "--initialize-at-build-time=com.alibaba.fastjson2",
            "--add-exports=org.graalvm.truffle.runtime/com.oracle.truffle.runtime=ALL-UNNAMED",
            "-H:+UnlockExperimentalVMOptions",
        ] + TRUFFLE_JIT_CHECKS + ["-H:-UnlockExperimentalVMOptions"],
        graalvm_sdk = "@graalvm_linux_amd64//:gvm",
        main_class = "dev.elide.truffledata.comparison.JsonComparison",
        optimization_mode = "2",
        tags = ["manual"],
        target_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ],
        deps = [":json_comparison"],
    )
    for name, executable, march in [
        ("json_svm", "json-comparison", "-march=compatibility"),
        ("json_svm_v3", "json-comparison-v3", "-march=x86-64-v3"),
    ]
]

