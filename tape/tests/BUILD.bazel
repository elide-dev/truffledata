load("@rules_java//java:defs.bzl", "java_test")

# The shared module's own contracts; JSON's suites (//json/tests) exercise it end to end.
java_test(
    name = "jvm",
    srcs = [
        "AliasExportKeyTest.java",
        "CompactTapeTest.java",
        "TapeBuilderDecimalRawSpanTest.java",
        "TapeOwnerTest.java",
        "TapeSessionCloseTest.java",
    ],
    args = [
        "--class",
        "dev.elide.truffledata.tape.AliasExportKeyTest",
        "--class",
        "dev.elide.truffledata.tape.TapeOwnerTest",
        "--class",
        "dev.elide.truffledata.tape.CompactTapeTest",
        "--class",
        "dev.elide.truffledata.tape.TapeBuilderDecimalRawSpanTest",
        "--class",
        "dev.elide.truffledata.tape.TapeSessionCloseTest",
    ],
    jvm_flags = [
        "-Dpolyglot.engine.WarnInterpreterOnly=false",
        "-ea",
    ],
    main_class = "dev.elide.bazel.junit.BazelJUnitRunner",
    use_testrunner = False,
    runtime_deps = [
        "//bazel/junit:runner",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
    deps = [
        "//tape",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@myna//:values",
    ],
)
