load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("@rules_cc//cc:defs.bzl", "cc_import")
load("@rules_graalvm//graalvm:defs.bzl", "native_image")
load("@rules_java//java:defs.bzl", "java_import", "java_library", "java_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:jit.bzl", "TRUFFLE_JIT_CHECKS")
load("//bazel:maven.bzl", "maven_publication", "release_version")
load("//bazel:maven_bom.bzl", "maven_bom")

release_version(
    name = "version",
    build_setting_default = "0.7.0-SNAPSHOT",
    visibility = ["//visibility:public"],
)

COMMON = [
    "org.graalvm.truffle:truffle-api:25.5.5-elide.24",
    "org.jspecify:jspecify:1.0.1",
]

MODULES = [
    "core",
    "jdbc",
    "jdbc-sqlite",
    "jdbc-mysql",
    "jdbc-postgresql",
    "protobuf",
    "protobuf-runtime",
    "protobuf-buffa",
    "protobuf-buffa-bindings",
    "json",
    "json-bindings",
    "json-jvm",
]

# Publication libraries that are not the module's own //<module> target.
LIBRARIES = {
    "protobuf-buffa-bindings": "//protobuf-buffa:bindings",
    "json-bindings": ":json_bindings_library",
    # JVM-only FFM backend, published separately so static images never carry it.
    "json-jvm": "//json:jvm",
}

# The generated JSON bindings plus the exact Myna value ABI runtime they were generated against.
# Myna is not published to Maven; its value classes ship with the bindings they must match.
java_library(
    name = "json_bindings_library",
    srcs = [
        "//json/native:java_bindings",
        "@myna//:values_sources",
    ],
    resource_strip_prefix = "json/native/generated",
    resources = ["//json/native:native_resources"],
    deps = [
        "//bazel:myna_compiler_sdk",
        "@maven//:org_graalvm_sdk_nativeimage",
        "@maven//:org_graalvm_sdk_word",
    ],
)

# One self-contained archive (C ABI, decoder and simdjson) for static SVM linking.
cc_static_library(
    name = "json_archive",
    deps = ["//json/native:truffledata_json"],
)

[maven_publication(
    name = module,
    attachments = {
        "//protobuf-buffa/native:truffledata_buffa": "-linux-x86_64.a",
        "//protobuf-buffa/native:shared": "-linux-x86_64.so",
        "//protobuf-buffa/native:header": "-native.h",
    } if module == "protobuf-buffa" else {
        ":json_archive": "-linux-x86_64.a",
        "//json/native:json_shared.so": "-linux-x86_64.so",
    } if module == "json" else {},
    dependencies = COMMON + ([] if module == "core" else ["dev.elide:truffledata-core:{version}"]) + ([
        "com.google.protobuf:protobuf-java:4.36.1",
        "com.google.protobuf:protobuf-java-util:4.36.1",
        "dev.elide:truffledata-protobuf-runtime:{version}",
    ] if module == "protobuf" else []) + ([
        "com.google.code.gson:gson:2.8.9",
    ] if module == "protobuf-runtime" else []) + ([
        "dev.elide:truffledata-protobuf-runtime:{version}",
        "dev.elide:truffledata-protobuf-buffa-bindings:{version}",
    ] if module == "protobuf-buffa" else []) + ([
        "dev.elide:truffledata-json-bindings:{version}",
    ] if module == "json" else []) + ([
        "dev.elide:truffledata-json:{version}",
        "dev.elide:truffledata-json-bindings:{version}",
    ] if module == "json-jvm" else []) + ([
        "org.graalvm.sdk:nativeimage:25.5.5-elide.24",
        "org.graalvm.sdk:word:25.5.5-elide.24",
    ] if module in [
        "protobuf-buffa",
        "protobuf-buffa-bindings",
        "json",
        "json-bindings",
    ] else []) + ([
        "dev.elide:truffledata-jdbc:{version}",
        "org.xerial:sqlite-jdbc:3.53.4.0",
    ] if module == "jdbc-sqlite" else []) + ([
        "dev.elide:truffledata-jdbc:{version}",
        "com.mysql:mysql-connector-j:26.10.0",
    ] if module == "jdbc-mysql" else []) + ([
        "dev.elide:truffledata-jdbc:{version}",
        "org.postgresql:postgresql:42.7.14",
    ] if module == "jdbc-postgresql" else []),
    library = LIBRARIES.get(module, "//%s" % module),
    module = module,
) for module in MODULES]

maven_bom(
    name = "bom",
    managed = COMMON + ["dev.elide:truffledata-" + module + ":{version}" for module in MODULES] + [
        "com.mysql:mysql-connector-j:26.10.0",
        "org.postgresql:postgresql:42.7.14",
        "org.xerial:sqlite-jdbc:3.53.4.0",
        "com.google.protobuf:protobuf-java:4.36.1",
        "com.google.protobuf:protobuf-java-util:4.36.1",
    ] + [coordinate + ":25.5.5-elide.24" for coordinate in [
        "org.graalvm.truffle:truffle-runtime",
        "org.graalvm.polyglot:polyglot",
        "org.graalvm.js:js-language",
        "org.graalvm.python:python-language",
        "org.graalvm.python:python-resources",
    ]],
)

filegroup(
    name = "publications",
    srcs = [":bom"] + [":" + module for module in MODULES],
)

sh_test(
    name = "test",
    srcs = ["test.sh"],
    data = [
        "maven_repo.py",
        "test_release.py",
        ":publications",
        "//:MODULE.bazel",
        "//:maven_install.json",
    ],
)

# Exercise consumption of the actual published jars, without source-library deps.
[filegroup(
    name = module + "_binary",
    srcs = [":" + module],
    output_group = "binary",
) for module in MODULES]

[java_import(
    name = module + "_import",
    jars = [":" + module + "_binary"],
    deps = [
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_jspecify_jspecify",
    ] + ([] if module == "core" else [":core_import"]) + ([
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:com_google_protobuf_protobuf_java_util",
        ":protobuf-runtime_import",
    ] if module == "protobuf" else []) + ([
        "@maven//:com_google_code_gson_gson",
    ] if module == "protobuf-runtime" else []) + ([
        ":protobuf-runtime_import",
        ":protobuf-buffa-bindings_import",
    ] if module == "protobuf-buffa" else []) + ([
        ":json-bindings_import",
    ] if module == "json" else []) + ([
        ":json-bindings_import",
        ":json_import",
    ] if module == "json-jvm" else []) + ([
        "@maven//:org_graalvm_sdk_nativeimage",
        "@maven//:org_graalvm_sdk_word",
    ] if module in [
        "protobuf-buffa",
        "protobuf-buffa-bindings",
        "json",
        "json-bindings",
    ] else []) + ([
        ":jdbc_import",
        "@maven//:org_xerial_sqlite_jdbc",
    ] if module == "jdbc-sqlite" else []) + ([
        ":jdbc_import",
        "@maven//:com_mysql_mysql_connector_j",
    ] if module == "jdbc-mysql" else []) + ([
        ":jdbc_import",
        "@maven//:org_postgresql_postgresql",
    ] if module == "jdbc-postgresql" else []),
) for module in MODULES]

java_test(
    name = "consumer_test",
    srcs = ["Consumer.java"],
    javacopts = ["-XepDisableAllChecks"],
    main_class = "Consumer",
    use_testrunner = False,
    deps = [
        ":core_import",
        ":jdbc-mysql_import",
        ":jdbc-postgresql_import",
        ":jdbc-sqlite_import",
        ":jdbc_import",
        ":protobuf-buffa_import",
        ":protobuf-runtime_import",
        ":protobuf_import",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:org_graalvm_truffle_truffle_api",
    ],
)

filegroup(
    name = "buffa_static",
    srcs = [":protobuf-buffa"],
    output_group = "native_static",
)

filegroup(
    name = "buffa_shared",
    srcs = [":protobuf-buffa"],
    output_group = "native_shared",
)

cc_import(
    name = "published_native",
    static_library = ":buffa_static",
    deps = ["//protobuf-buffa/native:cpp_runtime"],
)

java_library(
    name = "buffa_consumer_lib",
    testonly = True,
    srcs = ["BuffaConsumer.java"],
    deps = [
        ":core_import",
        ":protobuf-buffa_import",
        ":protobuf-runtime_import",
        ":protobuf_import",
        "@maven//:org_graalvm_sdk_nativeimage",
    ],
)

java_test(
    name = "buffa_consumer",
    args = ["$(location :buffa_shared)"],
    data = [":buffa_shared"],
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    main_class = "BuffaConsumer",
    use_testrunner = False,
    runtime_deps = [":buffa_consumer_lib"],
)

native_image(
    name = "buffa_native",
    testonly = True,
    cc_deps = [":published_native"],
    exec_properties = {
        "EstimatedCPU": "4",
        "EstimatedMemory": "16GB",
    },
    executable_name = "buffa-published-consumer",
    extra_args = [
        "--gc=serial",
        "--parallelism=4",
        "-march=compatibility",
        "--features=dev.elide.truffledata.buffa.BuffaFeature",
        "--initialize-at-build-time=dev.elide.truffledata",
        "-H:+UnlockExperimentalVMOptions",
    ] + TRUFFLE_JIT_CHECKS + ["-H:-UnlockExperimentalVMOptions"],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    main_class = "BuffaConsumer",
    optimization_mode = "2",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        ":buffa_consumer_lib",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

sh_test(
    name = "buffa_native_test",
    srcs = ["native_consumer.sh"],
    args = ["$(location :buffa_native)"],
    data = [":buffa_native"],
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

java_library(
    name = "stock_free_consumer_lib",
    testonly = True,
    srcs = ["StockFreeConsumer.java"],
    deps = [
        ":core_import",
        ":protobuf-buffa_import",
        ":protobuf-runtime_import",
        "//tests:wkt_contracts",
    ],
)

java_test(
    name = "stock_free_consumer",
    data = ["//tests:native_descriptors"],
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    main_class = "StockFreeConsumer",
    use_testrunner = False,
    runtime_deps = [":stock_free_consumer_lib"],
)

native_image(
    name = "stock_free_native",
    testonly = True,
    cc_deps = [":published_native"],
    exec_properties = {
        "EstimatedCPU": "4",
        "EstimatedMemory": "16GB",
    },
    executable_name = "stock-free-published-consumer",
    extra_args = [
        "--gc=serial",
        "--parallelism=4",
        "-march=compatibility",
        "--features=dev.elide.truffledata.buffa.BuffaFeature",
        "--initialize-at-build-time=dev.elide.truffledata",
        "-H:+UnlockExperimentalVMOptions",
    ] + TRUFFLE_JIT_CHECKS + ["-H:-UnlockExperimentalVMOptions"],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    main_class = "StockFreeConsumer",
    optimization_mode = "2",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        ":stock_free_consumer_lib",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

sh_test(
    name = "stock_free_native_test",
    srcs = ["native_consumer.sh"],
    args = [
        "$(location :stock_free_native)",
        "native",
    ],
    data = [
        ":stock_free_native",
        "//tests:native_descriptors",
    ],
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

filegroup(
    name = "json_static",
    srcs = [":json"],
    output_group = "native_static",
)

filegroup(
    name = "json_shared",
    srcs = [":json"],
    output_group = "native_shared",
)

cc_import(
    name = "published_json_native",
    static_library = ":json_static",
    deps = ["//protobuf-buffa/native:cpp_runtime"],
)

# Compile-only view of the JVM backend: the static image classpath never carries truffledata-json-jvm.
java_import(
    name = "json-jvm_compile",
    jars = [":json-jvm_binary"],
    neverlink = True,
    deps = [":json_import"],
)

java_library(
    name = "json_consumer_lib",
    testonly = True,
    srcs = ["JsonConsumer.java"],
    deps = [
        ":json-jvm_compile",
        ":json_import",
        "@maven//:org_graalvm_sdk_nativeimage",
    ],
)

java_test(
    name = "json_consumer",
    args = ["$(location :json_shared)"],
    data = [":json_shared"],
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    main_class = "JsonConsumer",
    use_testrunner = False,
    runtime_deps = [
        ":json-jvm_import",
        ":json_consumer_lib",
    ],
)

native_image(
    name = "json_native",
    testonly = True,
    cc_deps = [":published_json_native"],
    exec_properties = {
        "EstimatedCPU": "4",
        "EstimatedMemory": "16GB",
    },
    executable_name = "json-published-consumer",
    extra_args = [
        "--gc=serial",
        "--parallelism=4",
        "-march=compatibility",
        "--initialize-at-build-time=dev.elide.truffledata",
        "-H:+UnlockExperimentalVMOptions",
    ] + TRUFFLE_JIT_CHECKS + ["-H:-UnlockExperimentalVMOptions"],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    main_class = "JsonConsumer",
    optimization_mode = "2",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        ":json_consumer_lib",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

sh_test(
    name = "json_native_test",
    srcs = ["native_consumer.sh"],
    args = ["$(location :json_native)"],
    data = [":json_native"],
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
