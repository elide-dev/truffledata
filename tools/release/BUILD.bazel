load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("@rules_cc//cc:defs.bzl", "cc_import")
load("@rules_graalvm//graalvm:defs.bzl", "native_image")
load("@rules_java//java:defs.bzl", "java_import", "java_library", "java_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:jit.bzl", "TRUFFLE_JIT_CHECKS")
load("//bazel:maven.bzl", "classifier_attachments", "maven_publication", "native_attachments", "release_version")
load("//bazel:maven_bom.bzl", "maven_bom")
load("//bazel:release_archive.bzl", "release_archive")
load(":native_consumer.bzl", "native_consumers")

release_version(
    name = "version",
    build_setting_default = "0.9.0-SNAPSHOT",
    visibility = ["//visibility:public"],
)

COMMON = [
    "org.graalvm.truffle:truffle-api:25.5.5-elide.27",
    "org.jspecify:jspecify:1.0.1",
]

MODULES = [
    "core",
    "jdbc",
    "jdbc-sqlite",
    "jdbc-mysql",
    "jdbc-postgresql",
    "protobuf",
    "protobuf-runtime",
    "protobuf-buffa",
    "protobuf-buffa-bindings",
    "tape",
    "tape-jvm",
    "json",
    "json-bindings",
    "json-jvm",
    "csv",
    "csv-bindings",
    "csv-native",
    "csv-jvm",
]

# Publication libraries that are not the module's own //<module> target.
LIBRARIES = {
    "protobuf-buffa-bindings": "//protobuf-buffa:bindings",
    # The shared tape classes plus the exact Myna value ABI runtime they extend (YAML plan Task 4).
    "tape": ":tape_library",
    # JVM-only FFM tape reader, published separately like json-jvm.
    "tape-jvm": "//tape:jvm",
    "json-bindings": ":json_bindings_library",
    # JVM-only FFM backend, published separately so static images never carry it.
    "json-jvm": "//json:jvm",
    # Optional native CSV kernel: generated bindings, the static-image backend (with the native
    # attachments) and the JVM FFM backend; truffledata-csv itself stays pure Java.
    "csv-bindings": "//csv/kernel:bindings",
    "csv-native": "//csv/kernel:svm",
    "csv-jvm": "//csv/kernel:jvm",
}

# The shared tape classes plus the exact Myna value ABI runtime they read and extend. Myna is not
# published to Maven; its value classes ship in truffledata-tape, which every format depends on, so
# JSON and YAML never carry two copies. //tape itself is NullAway-checked; this republishes it.
java_library(
    name = "tape_library",
    srcs = [
        "//tape:tape_sources",
        "@myna//:values_sources",
    ],
    # //tape compiles the same sources under NullAway and the repository's checks.
    javacopts = ["-XepDisableAllChecks"],
    deps = [
        "//bazel:myna_compiler_sdk",
        "//bazel:truffle_processor",
        "//core",
        "@maven//:org_graalvm_sdk_nativeimage",
        "@maven//:org_graalvm_sdk_word",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_jspecify_jspecify",
    ],
)

# The generated JSON bindings; the Myna value runtime they were generated against ships in
# truffledata-tape from the same release.
java_library(
    name = "json_bindings_library",
    srcs = ["//json/native:java_bindings"],
    resource_strip_prefix = "json/native/generated",
    resources = ["//json/native:native_resources"],
    deps = [
        "//bazel:myna_compiler_sdk",
        "@maven//:org_graalvm_sdk_nativeimage",
        "@maven//:org_graalvm_sdk_word",
    ],
)

# The C ABI, decoder, simdjson and simdutf objects. cc_static_library collects object files only,
# so the Rust myna-values bridge archive is merged in by json_archive below.
cc_static_library(
    name = "json_objects",
    deps = ["//json/native:truffledata_json"],
)

# The CSV kernel C ABI, its ISA kernels and simdutf, for static SVM linking.
cc_static_library(
    name = "csv_objects",
    deps = ["//csv/native:truffledata_csv"],
)

# The YAML C ABI, decoder and rapidyaml. Not published yet; built per platform so it can be.
cc_static_library(
    name = "yaml_objects",
    deps = ["//yaml/native:truffledata_yaml"],
)

# Release static archives (bazel/release_archive.bzl): self-contained, and on ELF every member with bitcode is a fat
# object (machine code plus ThinLTO bitcode), so consumers link them with or without LTO; on Mach-O, which has no fat
# object format, every member is machine code. JSON is json_objects plus Myna's myna-values static library
# (myna_utf8_to_utf16_v2 for SvmValueTape, performance plan Task D1).
release_archive(
    name = "json_archive",
    archives = [
        ":json_objects",
        "//json/native/bridge",
    ],
)

release_archive(
    name = "csv_archive",
    archives = [":csv_objects"],
)

release_archive(
    name = "buffa_archive",
    archives = ["//protobuf-buffa/native:truffledata_buffa"],
)

release_archive(
    name = "yaml_archive",
    archives = [":yaml_objects"],
)

# Each release archive's member manifest (member kinds, for tools/release/check_natives.py) and, on macOS, its ThinLTO
# bitcode twin and that twin's manifest.
[filegroup(
    name = "%s_%s" % (archive, group),
    srcs = [":" + archive],
    output_group = group,
) for archive in [
    "buffa_archive",
    "csv_archive",
    "json_archive",
    "yaml_archive",
] for group in [
    "manifest",
    "bitcode",
    "bitcode_manifest",
]]

# Native modules: (static archive, shared library, platform-neutral attachments); classifiers per target platform are
# CLASSIFIERS in //bazel:maven.bzl. YAML is built, not yet published.
NATIVES = {
    "protobuf-buffa": (
        ":buffa_archive",
        "//protobuf-buffa/native:shared",
        {"//protobuf-buffa/native:header": "-native.h"},
    ),
    "json": (
        ":json_archive",
        "//json/native:json_shared.so",
        {},
    ),
    "csv-native": (
        ":csv_archive",
        "//csv/native:csv_shared.so",
        {},
    ),
    "yaml": (
        ":yaml_archive",
        "//yaml/native:yaml_shared.so",
        {},
    ),
}

# The target platform's native attachments for each module, in the publication's Maven layout without jars or POMs,
# plus the archives' member manifests for the release gate (never published). Each platform builds :natives in its own
# invocation (--config=remote, --config=remote_arm64, --config=local on macOS); tools/release/publish.sh collects the
# three sets and stages them beside the publications. Platform-neutral attachments (the Buffa header) come from the
# publications alone.
[native_attachments(
    name = module + "_natives",
    attachments = classifier_attachments(static, shared, {}, manifests = True),
    module = module,
) for module, (static, shared, _neutral) in NATIVES.items()]

filegroup(
    name = "natives",
    # YAML (unpublished) does not build for macOS yet: its scalars use floating-point std::from_chars, which the macOS
    # SDK's libc++ marks available from macOS 26, above --macos_minimum_os=12.0.
    srcs = [":%s_natives" % module for module in NATIVES if module != "yaml"] + select({
        "@platforms//os:macos": [],
        "//conditions:default": [":yaml_natives"],
    }),
)

# C consumers of each published native on the target platform (tools/release/native_consumer.bzl): the release static
# archive linked with LTO off and with ThinLTO (on macOS, the bitcode twin with ld64.lld), each checked by its LTO
# witness, and the release shared library loaded with dlopen. Linux runs them on RBE (--config=remote and
# --config=remote_arm64), macOS locally (--config=local).
native_consumers(
    name = "buffa_c",
    archive = ":buffa_archive",
    fingerprint = "td_buffa_fingerprint",
    shared = "//protobuf-buffa/native:shared",
)

native_consumers(
    name = "json_c",
    archive = ":json_archive",
    fingerprint = "td_json_fingerprint",
    probe = "td_json_bridge_present",
    shared = "//json/native:json_shared.so",
)

native_consumers(
    name = "csv_c",
    archive = ":csv_archive",
    fingerprint = "td_csv_fingerprint",
    shared = "//csv/native:csv_shared.so",
)

test_suite(
    name = "native_consumers",
    tags = ["native-consumer"],
)

[maven_publication(
    name = module,
    # This invocation's platform; the other platforms' attachments come from their :natives builds.
    attachments = classifier_attachments(NATIVES[module][0], NATIVES[module][1], NATIVES[module][2]) if module in NATIVES else {},
    dependencies = COMMON + ([] if module == "core" else ["dev.elide:truffledata-core:{version}"]) + ([
        "com.google.protobuf:protobuf-java:4.36.1",
        "com.google.protobuf:protobuf-java-util:4.36.1",
        "dev.elide:truffledata-protobuf-runtime:{version}",
    ] if module == "protobuf" else []) + ([
        "com.google.code.gson:gson:2.8.9",
    ] if module == "protobuf-runtime" else []) + ([
        "dev.elide:truffledata-protobuf-runtime:{version}",
        "dev.elide:truffledata-protobuf-buffa-bindings:{version}",
    ] if module == "protobuf-buffa" else []) + ([
        "dev.elide:truffledata-tape:{version}",
    ] if module == "tape-jvm" else []) + ([
        "dev.elide:truffledata-json-bindings:{version}",
        "dev.elide:truffledata-tape:{version}",
    ] if module == "json" else []) + ([
        "dev.elide:truffledata-json:{version}",
        "dev.elide:truffledata-json-bindings:{version}",
        "dev.elide:truffledata-tape-jvm:{version}",
    ] if module == "json-jvm" else []) + ([
        "dev.elide:truffledata-csv:{version}",
        "dev.elide:truffledata-csv-bindings:{version}",
    ] if module in [
        "csv-native",
        "csv-jvm",
    ] else []) + ([
        "org.graalvm.sdk:nativeimage:25.5.5-elide.27",
        "org.graalvm.sdk:word:25.5.5-elide.27",
    ] if module in [
        "protobuf-buffa",
        "protobuf-buffa-bindings",
        "tape",
        "json",
        "json-bindings",
        "csv-bindings",
        "csv-native",
    ] else []) + ([
        "dev.elide:truffledata-jdbc:{version}",
        "org.xerial:sqlite-jdbc:3.53.4.0",
    ] if module == "jdbc-sqlite" else []) + ([
        "dev.elide:truffledata-jdbc:{version}",
        "com.mysql:mysql-connector-j:26.10.0",
    ] if module == "jdbc-mysql" else []) + ([
        "dev.elide:truffledata-jdbc:{version}",
        "org.postgresql:postgresql:42.7.14",
    ] if module == "jdbc-postgresql" else []),
    library = LIBRARIES.get(module, "//%s" % module),
    module = module,
) for module in MODULES]

maven_bom(
    name = "bom",
    managed = COMMON + ["dev.elide:truffledata-" + module + ":{version}" for module in MODULES] + [
        "com.mysql:mysql-connector-j:26.10.0",
        "org.postgresql:postgresql:42.7.14",
        "org.xerial:sqlite-jdbc:3.53.4.0",
        "com.google.protobuf:protobuf-java:4.36.1",
        "com.google.protobuf:protobuf-java-util:4.36.1",
    ] + [coordinate + ":25.5.5-elide.27" for coordinate in [
        "org.graalvm.truffle:truffle-runtime",
        "org.graalvm.polyglot:polyglot",
        "org.graalvm.js:js-language",
        "org.graalvm.python:python-language",
        "org.graalvm.python:python-resources",
    ]],
)

filegroup(
    name = "publications",
    srcs = [":bom"] + [":" + module for module in MODULES],
)

