load("@rules_java//java:defs.bzl", "java_library", "java_test")
load("//bazel:java.bzl", "data_java_library")

package(default_visibility = ["//visibility:public"])

data_java_library(
    name = "protobuf-runtime",
    srcs = [
        "src/main/java/dev/elide/truffledata/protobuf/BoundedOutput.java",
        "src/main/java/dev/elide/truffledata/protobuf/GeneratedGraphInput.java",
        "src/main/java/dev/elide/truffledata/protobuf/GeneratedInput.java",
        "src/main/java/dev/elide/truffledata/protobuf/GeneratedMessage.java",
        "src/main/java/dev/elide/truffledata/protobuf/GeneratedOutput.java",
        "src/main/java/dev/elide/truffledata/protobuf/GeneratedSlabWriter.java",
        "src/main/java/dev/elide/truffledata/protobuf/Layout.java",
        "src/main/java/dev/elide/truffledata/protobuf/ProtoAccess.java",
        "src/main/java/dev/elide/truffledata/protobuf/ProtoCodec.java",
        "src/main/java/dev/elide/truffledata/protobuf/ProtoDescriptors.java",
        "src/main/java/dev/elide/truffledata/protobuf/ProtoJson.java",
        "src/main/java/dev/elide/truffledata/protobuf/ProtoJsonType.java",
        "src/main/java/dev/elide/truffledata/protobuf/ProtoMessage.java",
        "src/main/java/dev/elide/truffledata/protobuf/ProtoPlan.java",
        "src/main/java/dev/elide/truffledata/protobuf/ProtoRow.java",
        "src/main/java/dev/elide/truffledata/protobuf/ProtoText.java",
        "src/main/java/dev/elide/truffledata/protobuf/ProtoWire.java",
        "src/main/java/dev/elide/truffledata/protobuf/SlabArray.java",
        "src/main/java/dev/elide/truffledata/protobuf/SlabBytes.java",
        "src/main/java/dev/elide/truffledata/protobuf/SlabCodec.java",
        "src/main/java/dev/elide/truffledata/protobuf/SlabFormat.java",
        "src/main/java/dev/elide/truffledata/protobuf/SlabLimits.java",
        "src/main/java/dev/elide/truffledata/protobuf/SlabMessage.java",
        "src/main/java/dev/elide/truffledata/protobuf/SlabRow.java",
        "src/main/java/dev/elide/truffledata/protobuf/SlabVerifier.java",
        "src/main/java/dev/elide/truffledata/protobuf/package-info.java",
    ],
    deps = [
        "//core",
        "@maven//:com_google_code_gson_gson",
        "@maven//:org_graalvm_truffle_truffle_api",
    ],
)

# Slab layout compiler and the TDSLAB1 golden slabs (docs/SLAB.md); SlabReference is the
# executable model of the format that the Rust and Java producers must match byte for byte.
java_test(
    name = "test",
    size = "medium",
    srcs = [
        "src/test/java/dev/elide/truffledata/protobuf/LayoutTest.java",
        "src/test/java/dev/elide/truffledata/protobuf/SlabCodecTest.java",
        "src/test/java/dev/elide/truffledata/protobuf/SlabReference.java",
    ],
    args = [
        "--class",
        "dev.elide.truffledata.protobuf.LayoutTest",
        "--class",
        "dev.elide.truffledata.protobuf.SlabCodecTest",
    ],
    data = [":golden_slabs"],
    jvm_flags = [
        "-Dpolyglot.engine.WarnInterpreterOnly=false",
        "-ea",
    ],
    main_class = "dev.elide.bazel.junit.BazelJUnitRunner",
    use_testrunner = False,
    runtime_deps = [
        "//bazel/junit:runner",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
    deps = [
        ":protobuf-runtime",
        "//core",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

filegroup(
    name = "golden_slabs",
    srcs = glob(["src/test/resources/slab/*"]),
)

filegroup(
    name = "sources",
    srcs = glob(["src/main/java/**/*.java"]),
)

exports_files(["BUILD.bazel"])

# The cross-language producer gate reuses the independent schema/corpus fixture.
java_library(
    name = "slab_test_fixtures",
    testonly = True,
    srcs = [
        "src/test/java/dev/elide/truffledata/protobuf/LayoutTest.java",
        "src/test/java/dev/elide/truffledata/protobuf/SlabReference.java",
    ],
    deps = [
        ":protobuf-runtime",
        "//core",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)
