load("@rules_graalvm//graalvm:defs.bzl", "native_image")
load("@rules_java//java:defs.bzl", "java_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:java.bzl", "data_java_library")
load("//bazel:jit.bzl", "TRUFFLE_JIT_CHECKS")

data_java_library(
    name = "acceptance",
    testonly = True,
    srcs = ["CompiledReads.java", "SvmAcceptance.java", "TypedAcceptance.java", "TestLanguage.java", "package-info.java"],
    deps = ["//yaml", "//tape", "//core", "@maven//:org_graalvm_polyglot_polyglot", "@maven//:org_graalvm_truffle_truffle_api"],
)

java_test(
    name = "jvm",
    srcs = ["YamlContractTest.java", "YamlIntegrationTest.java", "YamlPlanTest.java"],
    args = ["--class", "dev.elide.truffledata.yaml.tests.YamlIntegrationTest", "--class", "dev.elide.truffledata.yaml.YamlContractTest", "--class", "dev.elide.truffledata.yaml.tests.YamlPlanTest"],
    data = ["//yaml/native:yaml_shared.so"],
    jvm_flags = ["--enable-native-access=ALL-UNNAMED", "-Dpolyglot.engine.WarnInterpreterOnly=false", "-ea"],
    main_class = "dev.elide.bazel.junit.BazelJUnitRunner",
    use_testrunner = False,
    runtime_deps = ["//bazel/junit:runner", "@maven//:org_graalvm_truffle_truffle_runtime"],
    deps = [":acceptance", "//yaml", "//yaml:jvm", "//tape", "//core", "@maven//:org_graalvm_truffle_truffle_api", "@maven//:org_junit_jupiter_junit_jupiter_api", "@maven//:org_snakeyaml_snakeyaml_engine"],
)

native_image(
    name = "native",
    testonly = True,
    cc_deps = ["//yaml/native:svm"],
    exec_properties = {"EstimatedCPU": "8", "EstimatedMemory": "24GB"},
    executable_name = "yaml_acceptance",
    extra_args = ["--gc=serial", "--initialize-at-build-time=dev.elide.truffledata", "-ea", "--parallelism=8", "-march=compatibility", "-H:+UnlockExperimentalVMOptions"] + TRUFFLE_JIT_CHECKS + ["-H:-UnlockExperimentalVMOptions"],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    main_class = "dev.elide.truffledata.yaml.tests.SvmAcceptance",
    optimization_mode = "2",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    deps = [":acceptance", "@maven//:org_graalvm_truffle_truffle_runtime"],
)
sh_test(
    name = "native_test",
    size = "large",
    srcs = ["native_test.sh"],
    args = ["$(rootpath :native)"],
    data = [":native"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)
