load("@rules_graalvm//graalvm:defs.bzl", "native_image")
load("@rules_java//java:defs.bzl", "java_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:java.bzl", "data_java_library")
load("//bazel:jit.bzl", "TRUFFLE_JIT_CHECKS")

data_java_library(
    name = "acceptance",
    testonly = True,
    srcs = [
        "CompiledArrayReads.java",
        "CompiledReads.java",
        "SvmAcceptance.java",
        "TestLanguage.java",
        "TypedAcceptance.java",
        "package-info.java",
    ],
    deps = [
        "//core",
        "//tape",
        "//yaml",
        "@maven//:org_graalvm_polyglot_polyglot",
        "@maven//:org_graalvm_truffle_truffle_api",
    ],
)

java_test(
    name = "jvm",
    srcs = [
        "JavaKernelDifferentialTest.java",
        "JavaKernelTest.java",
        "JsonSubsetDifferentialTest.java",
        "ScalarResolverTest.java",
        "SnakeYamlDifferentialTest.java",
        "YamlContractTest.java",
        "YamlEmitterTest.java",
        "YamlFuzz.java",
        "YamlIntegrationTest.java",
        "YamlPlanTest.java",
    ],
    args = [
        "--class",
        "dev.elide.truffledata.yaml.tests.YamlIntegrationTest",
        "--class",
        "dev.elide.truffledata.yaml.YamlContractTest",
        "--class",
        "dev.elide.truffledata.yaml.ScalarResolverTest",
        "--class",
        "dev.elide.truffledata.yaml.YamlEmitterTest",
        "--class",
        "dev.elide.truffledata.yaml.tests.YamlPlanTest",
        "--class",
        "dev.elide.truffledata.yaml.tests.SnakeYamlDifferentialTest",
        "--class",
        "dev.elide.truffledata.yaml.tests.JsonSubsetDifferentialTest",
        "--class",
        "dev.elide.truffledata.yaml.tests.JavaKernelTest",
        "--class",
        "dev.elide.truffledata.yaml.tests.JavaKernelDifferentialTest",
    ],
    data = [
        "java_kernel_excluded.txt",
        "snakeyaml_engine_excluded.txt",
        "//json/native:json_shared.so",
        "//yaml/native:testdata",
        "//yaml/native:yaml_shared.so",
        "@yaml_test_suite//:cases",
    ],
    jvm_flags = [
        "--enable-native-access=ALL-UNNAMED",
        "-Dpolyglot.engine.WarnInterpreterOnly=false",
        "-ea",
    ],
    main_class = "dev.elide.bazel.junit.BazelJUnitRunner",
    use_testrunner = False,
    runtime_deps = [
        "//bazel/junit:runner",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
    deps = [
        ":acceptance",
        "//benchmarks/comparison:json_fixture",
        "//core",
        "//json",
        "//json:jvm",
        "//tape",
        "//yaml",
        "//yaml:java",
        "//yaml:jvm",
        "//yaml:snakeyaml",
        "//yaml:svm",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_snakeyaml_snakeyaml_engine",
        "@myna//:values",
    ],
)

native_image(
    name = "native",
    testonly = True,
    cc_deps = ["//yaml/native:svm"],
    exec_properties = {
        "EstimatedCPU": "8",
        "EstimatedMemory": "24GB",
    },
    executable_name = "yaml_acceptance",
    extra_args = [
        "--gc=serial",
        "--initialize-at-build-time=dev.elide.truffledata",
        "-ea",
        "--parallelism=8",
        "-march=compatibility",
        "-H:+UnlockExperimentalVMOptions",
    ] + TRUFFLE_JIT_CHECKS + ["-H:-UnlockExperimentalVMOptions"],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    main_class = "dev.elide.truffledata.yaml.tests.SvmAcceptance",
    optimization_mode = "2",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        ":acceptance",
        "//yaml:svm",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

sh_test(
    name = "native_test",
    size = "large",
    srcs = ["native_test.sh"],
    args = ["$(rootpath :native)"],
    data = [":native"],
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
