        "src/main/java/dev/elide/truffledata/yaml/ResultMetadata.java",
        "src/main/java/dev/elide/truffledata/yaml/Style.java",
        "src/main/java/dev/elide/truffledata/yaml/KeyKind.java",
        "src/main/java/dev/elide/truffledata/yaml/Yaml.java",
        "src/main/java/dev/elide/truffledata/yaml/SvmSessionBackend.java",
        "src/main/java/dev/elide/truffledata/yaml/SvmTypedOwner.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlPlan.java",
        "src/main/java/dev/elide/truffledata/yaml/UnknownTags.java",
        "src/main/java/dev/elide/truffledata/yaml/VersionDirective.java",
