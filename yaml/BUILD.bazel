load("@rules_java//java:defs.bzl", "java_library")
load("//bazel:java.bzl", "data_java_library")

java_library(
    name = "bindings",
    srcs = ["//yaml/native:java_bindings"],
    resource_strip_prefix = "yaml/native/generated",
    resources = ["//yaml/native:native_resources"],
    visibility = ["//visibility:public"],
    deps = ["//bazel:myna_compiler_sdk", "@maven//:org_graalvm_sdk_nativeimage", "@maven//:org_graalvm_sdk_word"],
)

data_java_library(
    name = "yaml",
    srcs = [
        "src/main/java/dev/elide/truffledata/yaml/Aliases.java",
        "src/main/java/dev/elide/truffledata/yaml/DuplicateKeys.java",
        "src/main/java/dev/elide/truffledata/yaml/ResultMetadata.java",
        "src/main/java/dev/elide/truffledata/yaml/ScalarResolver.java",
        "src/main/java/dev/elide/truffledata/yaml/Style.java",
        "src/main/java/dev/elide/truffledata/yaml/KeyKind.java",
        "src/main/java/dev/elide/truffledata/yaml/Yaml.java",
        "src/main/java/dev/elide/truffledata/yaml/SvmSessionBackend.java",
        "src/main/java/dev/elide/truffledata/yaml/SvmTypedOwner.java",
        "src/main/java/dev/elide/truffledata/yaml/SvmYamlMessage.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlPlan.java",
        "src/main/java/dev/elide/truffledata/yaml/UnknownTags.java",
        "src/main/java/dev/elide/truffledata/yaml/VersionDirective.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlDirectives.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlLimits.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlMessage.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlMetadata.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlOptions.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlSchema.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlLinkage.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlSession.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlSessionProvider.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlStream.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlStreamOptions.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlSvm.java",
        "src/main/java/dev/elide/truffledata/yaml/package-info.java",
    ],
    # Initializes YamlLinkage at image build time, so images without the archive's bindings never
    # reach the @CFunction backend.
    resource_strip_prefix = "yaml/src/main/resources",
