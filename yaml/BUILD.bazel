    resource_strip_prefix = "yaml/native/generated",
    resources = ["//yaml/native:native_resources"],
    visibility = ["//visibility:public"],
    deps = ["//bazel:myna_compiler_sdk", "@maven//:org_graalvm_sdk_nativeimage", "@maven//:org_graalvm_sdk_word"],
