        "src/main/java/dev/elide/truffledata/yaml/YamlOptions.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlSchema.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlSession.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlStream.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlStreamOptions.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlSvm.java",
        "src/main/java/dev/elide/truffledata/yaml/package-info.java",
    ],
    visibility = ["//visibility:public"],
    exports = ["//tape"],
    deps = [
        ":bindings",
        "//tape",
        "//core",
        "@myna//:values",
        "@maven//:org_graalvm_sdk_nativeimage",
        "@maven//:org_graalvm_sdk_word",
        "@maven//:org_graalvm_truffle_truffle_api",
