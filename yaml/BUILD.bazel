data_java_library(
    name = "jvm",
    srcs = [
        "src/main/java/dev/elide/truffledata/yaml/JvmSessionBackend.java",
        "src/main/java/dev/elide/truffledata/yaml/JvmTypedOwner.java",
        "src/main/java/dev/elide/truffledata/yaml/JvmPlanBackend.java",
        "src/main/java/dev/elide/truffledata/yaml/YamlJvm.java",
    ],
