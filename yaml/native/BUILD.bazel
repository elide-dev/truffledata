load("//tools/fuzz:defs.bzl", "native_fuzzer")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//bazel:myna.bzl", "myna_bindings", "myna_other_class_stub")

# Test-only yaml-test-suite event renderer over rapidyaml's ParseEngine. Header-only and
# configuration-neutral: link it with exactly one of @rapidyaml//:ryml or @rapidyaml//:ryml_assert.
cc_library(
    name = "ryml_events",
    testonly = True,
    hdrs = ["ryml_events.h"],
    copts = ["-std=c++17"],
    deps = ["@rapidyaml//:ryml"],
)

cc_library(
    name = "ryml_events_assert",
    testonly = True,
    hdrs = ["ryml_events.h"],
    copts = ["-std=c++17"],
    deps = ["@rapidyaml//:ryml_assert"],
)

_SUITE_ARGS = [
    "--expected-failures=$(rootpath ryml_expected_failures.txt)",
    "$(rootpaths @yaml_test_suite//:inputs)",
]

_SUITE_DATA = [
    "ryml_expected_failures.txt",
    "@yaml_test_suite//:cases",
    "@yaml_test_suite//:inputs",
]

# Production configuration: 402/402 on the yaml-test-suite and linear one-line flow documents.
cc_test(
    name = "ryml_config_test",
    size = "medium",
    srcs = ["ryml_config_test.cc"],
    args = _SUITE_ARGS,
    copts = [
        "-std=c++17",
        "-O3",
    ],
    data = _SUITE_DATA,
    deps = [":ryml_events"],
)

# The assertion lane: the same suite with rapidyaml's assertions on (linearity skipped; with
# assertions, long flow lines are quadratic, biojppm/rapidyaml#694).
cc_test(
    name = "ryml_config_assert_test",
    size = "medium",
    srcs = ["ryml_config_test.cc"],
    args = ["--assert-lane"] + _SUITE_ARGS,
    copts = [
        "-std=c++17",
        "-O3",
    ],
    data = _SUITE_DATA,
    local_defines = ["TD_RYML_ASSERT_LANE"],
    deps = [":ryml_events_assert"],
)

# ---- The native YAML decoder (plan Task 2) -----------------------------------------------------

# Myna names GNU Linux targets only. This seam uses libc-independent LP64 C scalars/pointers, so
# musl consumes the same generated layout and its ABI class's fingerprint (seam.h selects it by the
# compiler's char signedness); the static-only musl archive is compiled and executed in its own gates
# (//tools/release:yaml_archive_test, :yaml_musl_c_*).
myna_bindings(
    name = "bindings",
    java_class = "Yaml",
    java_package = "dev.elide.truffledata.yaml.generated",
    seam = "yaml.seam",
    visibility = ["//visibility:public"],
)

# Header-only decoder core: input preparation, scalar resolution and tags, the rapidyaml event
# handler with anchors, aliases and merge keys, sessions and document streams. rapidyaml's defines (assertions off, tab tokens, exception callbacks) reach every
# translation unit that instantiates ParseEngine<yaml::handler> through @rapidyaml//:ryml.
cc_library(
    name = "decoder",
    hdrs = [
        "decoder.h",
        "errors.h",
        "input.h",
        "merge.h",
        "scalars.h",
        "session.h",
        "stream.h",
        "tags.h",
        "typed.h",
    ],
    copts = ["-std=c++17"],
    visibility = ["//yaml:__subpackages__"],
    deps = [
        "//bazel:unicode",
        "//tape/native:tape",
        "@myna//:values_headers",
        "@rapidyaml//:ryml",
        "@simdjson",
    ],
)

cc_test(
    name = "typed_test",
    srcs = ["typed_test.cc"],
    copts = ["-std=c++17"],
    deps = [":decoder", ":testing"],
)

cc_library(
    name = "truffledata_yaml",
    srcs = ["api.cc"],
    hdrs = [
        "api.h",
        "generated/seam.h",
    ],
    copts = [
        "-std=c++17",
        "-O3",
    ],
    linkopts = select({
        "@platforms//os:macos": ["-lc++"],
        "//conditions:default": [
            "-lc++",
            "-lc++abi",
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [":decoder"],
)

# The C ABI headers for consumers of the release archive (the isolated archive test).
filegroup(
    name = "header",
    srcs = [
        "api.h",
        "generated/seam.h",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "java_bindings",
    srcs = [
        "generated/Yaml.java",
        "generated/YamlAbi.java",
        "generated/YamlFFM.java",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "native_resources",
    srcs = ["generated/META-INF/native-image/dev.elide.myna/dev.elide.truffledata.yaml.generated.Yaml/native-image.properties"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "descriptor",
    srcs = ["generated/seam.json"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "yaml_shared.so",
    srcs = ["api.cc"],
    copts = [
        "-std=c++17",
        "-O3",
    ],
    linkopts = select({
        # The macos-aarch64 release attachment (tools/release) is loaded through @rpath.
        "@platforms//os:macos": ["-Wl,-install_name,@rpath/libtruffledata_yaml.dylib", "-Wl,-dead_strip_dylibs"],
        "//conditions:default": [],
    }),
    linkshared = True,
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [":truffledata_yaml"],
)

