# Native reference rows (plan Task 2 Step 4): rapidyaml's integer handler and tree, libyaml, and
# the session and stream APIs, in one process, three passes. The binary is Linux-only on RBE, so it
# runs as a manual test there: `bazel test //yaml/native:bench --test_output=all`.
cc_test(
    name = "bench",
    size = "large",
    srcs = ["bench.cc"],
    args = ["--passes=3"] + ["$(rootpaths :testdata)"],
    copts = [
        "-std=c++17",
        "-O3",
    ],
    data = [":testdata"],
    # Statically linked like the production yaml_shared.so: test binaries otherwise load every
    # dependency as a shared object, which puts PLT calls between the parser and the handler.
    linkstatic = True,
    tags = ["manual"],
    deps = [
        ":reference_tape",
        ":sampler",
        ":truffledata_yaml",
        "@libyaml",
    ],
)

# Compact producer qualification: Task8 preserves the measured0.715 baseline as its hard floor.
cc_test(
    name = "compact_bench",
    size = "large",
    srcs = ["bench.cc"],
    args = ["--passes=3", "--minimum-ratio=0.715"] + ["$(rootpaths :testdata)"],
    copts = ["-std=c++17", "-O3"],
    data = [":testdata"],
    linkstatic = True,
    tags = ["manual"],
    deps = [":reference_tape", ":sampler", ":truffledata_yaml", "@libyaml"],
)

cc_test(
