# The same binary sampling 40 s of td-session decode and of ryml-ints(scan) per record fixture on an RBE
# worker (sampler.h; perf is unavailable there). Samples land in the test's undeclared outputs;
# symbolize them against the binary as yaml/native/README.md describes.
cc_test(
    name = "bench_profile",
    size = "large",
    srcs = ["bench.cc"],
    args = [
        "--profile=40",
        "$(rootpath testdata/config.yaml)",
        "$(rootpath testdata/records-block.yaml)",
        "$(rootpath testdata/records-flow.yaml)",
        "$(rootpath testdata/records-stream.yaml)",
        "$(rootpath testdata/text-heavy.yaml)",
    ],
    copts = [
        "-std=c++17",
        "-O3",
    ],
    data = [
        "testdata/config.yaml",
        "testdata/records-block.yaml",
        "testdata/records-flow.yaml",
        "testdata/records-stream.yaml",
        "testdata/text-heavy.yaml",
    ],
    # Statically linked like the production yaml_shared.so: test binaries otherwise load every
    # dependency as a shared object, which puts PLT calls between the parser and the handler.
    linkstatic = True,
    tags = ["manual"],
    deps = [
        ":reference_tape",
        ":sampler",
        ":truffledata_yaml",
        "@libyaml",
    ],
)

