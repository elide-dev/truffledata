module truffledata_yaml abi=5 target=x86_64-unknown-linux-gnu java_package=dev.elide.truffledata.yaml.generated java_class=Yaml c_library=truffledata_yaml c_library_static=true
# The integer protocol of the C ABI. api.h, api.cc and the Java bindings take every code, flag and
# limit below from the generated seam.h and <Class>Constants; nothing else defines these numbers.
#
# Status codes, as JSON's plus the YAML ones. No C++ exception crosses the C boundary.
enum Status type=i32
  value ok = 0
  value argument = 1
  value limit = 2
  value allocation = 3
  value syntax = 4
  value internal = 5
  value contract = 6
  value multiple_documents = 7
  value stream_empty = 8
  value stream_truncated = 9
  value text_too_small = 10
end
# session_decode and stream_next flags. want_utf16_text and session_decode's inline text arguments
# stay reserved (rejected): use session_write_text after decode.
flags DecodeFlags type=u32
  bit want_utf16_text = 0
  bit retain_source = 1
  bit want_directories = 2
end
# YamlOptionsStruct policies (YamlOptions on the Java side).
enum Schema type=u32
  value core = 0
  value json = 1
  value failsafe = 2
  value yaml_1_1 = 3
end
# pairs is not in YamlOptions yet: a mapping with a duplicate key (or, under complex_keys pairs, a
# collection key) becomes an ARRAY of 2-element [key, value] ARRAYs with the pair style.
enum DuplicateKeys type=u32
  value reject = 0
  value last_wins = 1
  value pairs = 2
end
enum ComplexKeys type=u32
  value reject = 0
  value pairs = 1
end
enum Aliases type=u32
  value allow = 0
  value reject = 1
end
enum UnknownTags type=u32
  value preserve = 0
  value reject = 1
end
enum VersionDirective type=u32
  value ignore = 0
  value honor = 1
end
# YamlOptionsStruct.max_depth is at most this.
const MAX_DEPTH type=u32 value=128
# Error messages are NUL-terminated in a fixed buffer at offsetof(<result>, error_message).
const ERROR_MESSAGE_CAPACITY type=u32 value=256
# YamlResult.document_flags.
flags DocumentFlags type=u32
  bit explicit_start = 0
  bit explicit_end = 1
  bit nonfinite = 2
  bit source_retained = 3
  bit present = 4
  bit schema_1_1 = 5
end
# One yaml_meta word per compact tape word (payload entries zero). tag is the 1-based index into
# `tags` (0 none) or, on aliases, private producer bookkeeping (consumers resolve the REF word).
enum Style type=u32
  value plain = 0
  value single_quoted = 1
  value double_quoted = 2
  value literal = 3
  value folded = 4
  value block = 5
  value flow = 6
  value pair = 7
end
enum KeyKind type=u32
  value string = 0
  value null = 1
  value boolean = 2
  value integer = 3
  value floating = 4
end
flags Meta type=u32
  range style = 0..2 enum=Style
  bit anchored = 3
  bit alias = 4
  range key_kind = 5..7 enum=KeyKind
  range tag = 8..31
end
# Typed plans (YamlScalarField).
enum FieldKind type=u32
  value boolean = 0
  value int64 = 1
  value uint64 = 2
  value float64 = 3
  value string = 4
  value record = 5
end
flags FieldFlags type=u32
  bit required = 0
  bit nullable = 1
  bit repeated = 2
end
enum LengthUnit type=u32
  value unknown = 0
  value utf16 = 1
  value scalar_values = 2
end
# YamlScalarField.child of a non-record field.
const NO_CHILD type=u32 value=0xffffffff
# plan_create limits: records per plan and fields per record.
const MAX_PLAN_RECORDS type=u64 value=65536
const MAX_RECORD_FIELDS type=u64 value=64
opaque YamlSession
opaque YamlStream
struct YamlResult size=448 align=8
  field owner type=ptr<void> offset=0
