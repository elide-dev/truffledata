  field strings type=ptr<u8> offset=112 count=strings_length
  field strings_length type=u64 offset=120
  field directives type=ptr<YamlTagDirective> offset=128 count=directive_count
  field directive_count type=u64 offset=136
  field source type=ptr<u8> offset=144 count=source_length
  field source_length type=u64 offset=152
