load("@rules_java//java:defs.bzl", "java_binary", "java_import", "java_library", "java_plugin")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

java_plugin(
    name = "nullaway",
    deps = ["@maven//:com_uber_nullaway_nullaway"],
)

TRUFFLE_PROCESSORS = [
    "com.oracle.truffle.dsl.processor.TruffleProcessor",
    "com.oracle.truffle.dsl.processor.verify.VerifyTruffleProcessor",
    "com.oracle.truffle.dsl.processor.LanguageRegistrationProcessor",
    "com.oracle.truffle.dsl.processor.verify.VerifyCompilationFinalProcessor",
]

[
    java_plugin(
        name = "truffle_" + p.split(".")[-1],
        processor_class = p,
        deps = ["@maven//:org_graalvm_truffle_truffle_dsl_processor"],
    )
    for p in TRUFFLE_PROCESSORS
]

java_library(
    name = "truffle_processor",
    exported_plugins = [":truffle_" + p.split(".")[-1] for p in TRUFFLE_PROCESSORS],
)

java_plugin(
    name = "jmh_processor",
    processor_class = "org.openjdk.jmh.generators.BenchmarkProcessor",
    deps = ["@maven//:org_openjdk_jmh_jmh_generator_annprocess"],
)

java_binary(
    name = "format",
    jvm_flags = ["--add-exports=jdk.compiler/com.sun.tools.javac.%s=ALL-UNNAMED" % p for p in [
        "api",
        "file",
        "parser",
        "tree",
        "util",
        "code",
    ]],
    main_class = "com.google.googlejavaformat.java.Main",
    runtime_deps = ["@maven//:com_google_googlejavaformat_google_java_format"],
)

exports_files([
    "myna.BUILD",
    "cells_seam.py",
    "myna_abi.py",
    "java.bzl",
    "protobuf.bzl",
    "elide_toolchain.BUILD",
    "musl_toolchain.BUILD",
    "release_archive.sh",
    "publication.sh",
])

# Myna binding ABI 2 compiler intrinsics: compile only, never application/runtime jars.
java_import(
    name = "myna_compiler_sdk",
    jars = select({
        "//bazel/platforms:macos_arm64": ["@graalvm_macos_aarch64//:lib/svm/" + jar for jar in [
            "svm-shared.jar",
            "svm-guest-staging.jar",
            "svm-guest.jar",
        ]],
        "//bazel/platforms:linux_arm64": ["@graalvm_linux_aarch64//:lib/svm/" + jar for jar in [
            "svm-shared.jar",
            "svm-guest-staging.jar",
            "svm-guest.jar",
        ]],
        "//conditions:default": ["@graalvm_linux_amd64//:lib/svm/" + jar for jar in [
            "svm-shared.jar",
            "svm-guest-staging.jar",
            "svm-guest.jar",
        ]],
    }),
    neverlink = True,
)

sh_test(
    name = "myna_contract",
    srcs = ["myna_contract.py"],
    args = [
        # Production seams: descriptor, bindings jar, then each ABI class's descriptor and fingerprint
        # (bazel/myna.bzl): the jar's <Class>Abi constants must be exactly those fingerprints.
        "$(rootpath //json/native:descriptor)",
        "$(rootpath //json:libbindings.jar)",
        "--classes",
        "$(rootpath //json/native:generated/abi/lp64_little/seam.json)",
        "$(rootpath //json/native:generated/abi/lp64_little/seam.abi)",
        "$(rootpath //json/native:generated/abi/lp64_little_aapcs64/seam.json)",
        "$(rootpath //json/native:generated/abi/lp64_little_aapcs64/seam.abi)",
        "$(rootpath //protobuf-buffa/native:descriptor)",
        "$(rootpath //protobuf-buffa:libbindings.jar)",
        "--classes",
        "$(rootpath //protobuf-buffa/native:generated/abi/lp64_little/seam.json)",
        "$(rootpath //protobuf-buffa/native:generated/abi/lp64_little/seam.abi)",
        "$(rootpath //protobuf-buffa/native:generated/abi/lp64_little_aapcs64/seam.json)",
        "$(rootpath //protobuf-buffa/native:generated/abi/lp64_little_aapcs64/seam.abi)",
        "$(rootpath //yaml/native:descriptor)",
        "$(rootpath //yaml:libbindings.jar)",
        "--classes",
        "$(rootpath //yaml/native:generated/abi/lp64_little/seam.json)",
        "$(rootpath //yaml/native:generated/abi/lp64_little/seam.abi)",
        "$(rootpath //yaml/native:generated/abi/lp64_little_aapcs64/seam.json)",
        "$(rootpath //yaml/native:generated/abi/lp64_little_aapcs64/seam.abi)",
        "$(rootpath //csv/native:descriptor)",
        "$(rootpath //csv/kernel:libbindings.jar)",
        "--classes",
        "$(rootpath //csv/native:generated/abi/lp64_little/seam.json)",
        "$(rootpath //csv/native:generated/abi/lp64_little/seam.abi)",
        "$(rootpath //csv/native:generated/abi/lp64_little_aapcs64/seam.json)",
        "$(rootpath //csv/native:generated/abi/lp64_little_aapcs64/seam.abi)",
        # The opt-in Truffle cells bindings (protobuf-buffa/cells): derived from the production seam.
        "$(rootpath //protobuf-buffa/cells:generated/svm/seam.json)",
        "$(rootpath //protobuf-buffa/cells:libbindings.jar)",
        "$(rootpath //protobuf-buffa/cells:generated/jvm/seam.json)",
        "-",
        # The opt-in YAML cells bindings (yaml/cells): derived from the production seam.
        "$(rootpath //yaml/cells:generated/svm/seam.json)",
        "$(rootpath //yaml/cells:libbindings.jar)",
        "$(rootpath //yaml/cells:generated/jvm/seam.json)",
        "-",
        # The opt-in CSV kernel cells bindings (csv/cells): derived from the production seam.
        "$(rootpath //csv/cells:generated/svm/seam.json)",
        "$(rootpath //csv/cells:libbindings.jar)",
        "$(rootpath //csv/cells:generated/jvm/seam.json)",
        "-",
        # The opt-in JSON cells bindings (json/cells): derived from the production seam.
        "$(rootpath //json/cells:generated/svm/seam.json)",
        "$(rootpath //json/cells:libbindings.jar)",
        "$(rootpath //json/cells:generated/jvm/seam.json)",
        "-",
        "--derived",
        "$(rootpath //csv/native:descriptor)",
        "$(rootpath //csv/cells:generated/svm/seam.json)",
        "$(rootpath //csv/cells:generated/jvm/seam.json)",
        "--derived",
        "$(rootpath //json/native:descriptor)",
        "$(rootpath //json/cells:generated/svm/seam.json)",
        "$(rootpath //json/cells:generated/jvm/seam.json)",
        "--derived",
        "$(rootpath //protobuf-buffa/native:descriptor)",
        "$(rootpath //protobuf-buffa/cells:generated/svm/seam.json)",
        "$(rootpath //protobuf-buffa/cells:generated/jvm/seam.json)",
        "--derived",
        "$(rootpath //yaml/native:descriptor)",
        "$(rootpath //yaml/cells:generated/svm/seam.json)",
        "$(rootpath //yaml/cells:generated/jvm/seam.json)",
    ],
    data = [
        "//csv/cells:generated/jvm/seam.json",
        "//csv/cells:generated/svm/seam.json",
        "//csv/cells:libbindings.jar",
        "//csv/kernel:libbindings.jar",
        "//csv/native:descriptor",
        "//json:libbindings.jar",
        "//json/cells:generated/jvm/seam.json",
        "//json/cells:generated/svm/seam.json",
        "//json/cells:libbindings.jar",
        "//json/native:descriptor",
        "//protobuf-buffa:libbindings.jar",
        "//protobuf-buffa/cells:generated/jvm/seam.json",
        "//protobuf-buffa/cells:generated/svm/seam.json",
        "//protobuf-buffa/cells:libbindings.jar",
        "//protobuf-buffa/native:descriptor",
        "//yaml:libbindings.jar",
        "//yaml/cells:generated/jvm/seam.json",
        "//yaml/cells:generated/svm/seam.json",
        "//yaml/cells:libbindings.jar",
        "//yaml/native:descriptor",
    ] + [
        "//%s:generated/abi/%s/%s" % (pkg, cls, file)
        for pkg in [
            "csv/native",
            "json/native",
            "protobuf-buffa/native",
            "yaml/native",
        ]
        for cls in [
            "lp64_little",
            "lp64_little_aapcs64",
        ]
        for file in [
            "seam.abi",
            "seam.json",
        ]
    ],
)

# Same pinned source/object implementation for Rust and native C++ consumers.
alias(
    name = "unicode",
    actual = "@simdutf_src//:native",
)
