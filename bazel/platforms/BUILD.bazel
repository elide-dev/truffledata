load("//bazel:versions.bzl", "RBE_IMAGE", "RBE_IMAGE_ARM64")

package(default_visibility = ["//visibility:public"])

# Host platform conditions (os_cpu), for per-platform inputs such as compile-latency budgets.
[config_setting(
    name = "%s_%s" % (os, cpu),
    constraint_values = [
        "@platforms//os:" + os,
        "@platforms//cpu:" + {
            "amd64": "x86_64",
            "arm64": "aarch64",
        }[cpu],
    ],
) for os, cpu in [
    ("macos", "arm64"),
    ("linux", "amd64"),
    ("linux", "arm64"),
]]

# BuildBuddy's remote Linux executors (--config=remote): Firecracker microVMs from RBE_IMAGE, no network (actions are
# hermetic: every input is declared). Actions needing more set exec_properties (bazel/test.bzl, native images).
platform(
    name = "rbe_linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "Arch": "amd64",
        "container-image": RBE_IMAGE,
        "workload-isolation-type": "firecracker",
        "network": "off",
        # BuildBuddy's cloud executors, whatever the organization's default.
        "use-self-hosted-executors": "false",
        # Most actions run a JVM (JavaBuilder, kotlinc, generators): room beyond the small default VM.
        "EstimatedCPU": "2",
        "EstimatedMemory": "6GB",
    },
)

# BuildBuddy's arm64 Linux executors (--config=remote_arm64): the same image built for arm64, so linux-aarch64 natives
# build and run natively with the Elide linux-arm64 toolchain bundle and the aarch64 Rust and GraalVM toolchains.
platform(
    name = "rbe_linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "Arch": "arm64",
        "container-image": RBE_IMAGE_ARM64,
        "workload-isolation-type": "firecracker",
        "network": "off",
        "use-self-hosted-executors": "false",
        "EstimatedCPU": "2",
        "EstimatedMemory": "6GB",
    },
)

# The default keeps existing Linux builds on glibc. Musl is an explicit release lane.
constraint_setting(
    name = "libc",
    default_constraint_value = ":glibc",
)

constraint_value(
    name = "glibc",
    constraint_setting = ":libc",
)

constraint_value(
    name = "musl",
    constraint_setting = ":libc",
)

[platform(
    name = "linux_" + cpu + "_musl",
    constraint_values = [":musl"],
    parents = [":rbe_linux_" + cpu],
) for cpu in [
    "amd64",
    "arm64",
]]

[config_setting(
    name = "musl_" + cpu,
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:" + arch,
        ":musl",
    ],
) for cpu, arch in [
    ("amd64", "x86_64"),
    ("arm64", "aarch64"),
]]

# Opt-in GCP workers: same image/toolchains and hermetic network policy as hosted RBE.
platform(
    name = "rbe_linux_amd64_shared",
    parents = [":rbe_linux_amd64"],
    exec_properties = {
        "workload-isolation-type": "oci",
        "use-self-hosted-executors": "true",
        "Pool": "bb-native-128",
    },
)
