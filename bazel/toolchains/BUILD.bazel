load("@rules_java//toolchains:default_java_toolchain.bzl", "DEFAULT_TOOLCHAIN_CONFIGURATION", "default_java_toolchain")

alias(
    name = "graalvm_jdk",
    actual = select({
        "//bazel/platforms:macos_arm64": "@graalvm_macos_aarch64//:jdk",
        "//bazel/platforms:linux_amd64": "@graalvm_linux_amd64//:jdk",
        "//bazel/platforms:linux_arm64": "@graalvm_linux_aarch64//:jdk",
    }),
    visibility = ["//visibility:public"],
)

# Java compilation on the fork's JDK (Gradle's toolchain): javac, JavaBuilder and the system modules all come from it,
# so --add-modules=org.graalvm.nativeimage resolves as it does under Gradle.
default_java_toolchain(
    name = "graalvm_java25",
    configuration = DEFAULT_TOOLCHAIN_CONFIGURATION,
    java_runtime = ":graalvm_jdk",
    # Every Java compilation (Kotlin modules' Java sources too) runs NullAway where //bazel:nullaway is a plugin.
    source_version = "25",
    target_version = "25",
)

[toolchain(
    name = "elide_cc_" + bundle,
    exec_compatible_with = constraints,
    target_compatible_with = constraints + (["//bazel/platforms:glibc"] if bundle.startswith("linux_") else []),
    toolchain = "@elide_toolchain_%s//:cc_toolchain" % bundle,
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
) for bundle, constraints in {
    "darwin_arm64": [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
    "linux_amd64": [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    "linux_arm64": [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
}.items()]

[toolchain(
    name = "elide_cc_linux_" + cpu + "_musl",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:" + arch,
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:" + arch,
        "//bazel/platforms:musl",
    ],
    toolchain = "@elide_toolchain_musl_" + cpu + "//:cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
) for cpu, arch in [
    ("amd64", "x86_64"),
    ("arm64", "aarch64"),
]]

# Static musl consumers have no loader dependency and run on the matching GNU Linux executor.
# Bazel 9's default shell-test toolchain otherwise insists on a musl execution platform.
[toolchain(
    name = "musl_static_tests_" + cpu,
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:" + arch,
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:" + arch,
        "//bazel/platforms:musl",
    ],
    toolchain = "@bazel_tools//tools/test:empty_toolchain",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
) for cpu, arch in [
    ("amd64", "x86_64"),
    ("arm64", "aarch64"),
]]
