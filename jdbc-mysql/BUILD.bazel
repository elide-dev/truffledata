load("//bazel:java.bzl", "data_java_library")

package(default_visibility = ["//visibility:public"])

data_java_library(
    name = "jdbc-mysql",
    srcs = [
        "src/main/java/dev/elide/truffledata/jdbc/mysql/MysqlAdapter.java",
        "src/main/java/dev/elide/truffledata/jdbc/mysql/package-info.java",
    ],
    deps = [
        "//core",
        "//jdbc",
        "@maven//:com_mysql_mysql_connector_j",
        "@maven//:org_graalvm_truffle_truffle_api",
    ],
)

filegroup(
    name = "sources",
    srcs = glob(["src/main/java/**/*.java"]),
)

exports_files(["BUILD.bazel"])
