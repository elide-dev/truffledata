load("//bazel:java.bzl", "data_java_library")

package(default_visibility = ["//visibility:public"])

data_java_library(
    name = "jdbc-postgresql",
    srcs = [
        "src/main/java/dev/elide/truffledata/jdbc/postgresql/PostgresqlAdapter.java",
        "src/main/java/dev/elide/truffledata/jdbc/postgresql/package-info.java",
    ],
    deps = [
        "//core",
        "//jdbc",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_postgresql_postgresql",
    ],
)

filegroup(
    name = "sources",
    srcs = glob(["src/main/java/**/*.java"]),
)

exports_files(["BUILD.bazel"])
