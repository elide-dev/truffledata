load("@rules_java//java:defs.bzl", "java_library")
load("//bazel:java.bzl", "data_java_library")
load("//bazel:myna.bzl", "myna_bindings")

package(default_visibility = ["//visibility:public"])

# truffledata-csv-cells: the opt-in route that makes the CSV kernel's index calls through
# Myna-generated Truffle cells, modelled on //protobuf-buffa/cells (WS12). Selected only by
# -Dtruffledata.csv.cells=true, read once into a static final (CsvCells.ENABLED). With the flag off
# nothing here is reachable and the production //csv/kernel route is byte-for-byte unchanged.
#
# The cells come from a seam *derived* from the production //csv/native:csv.seam: only the module
# line changes (cells options, package and class), so every import is the production one by
# construction and the production fingerprint, bindings and natives are unchanged. The backend
# verifies the library against the production fingerprint (CsvNativeAbi).
#
# JVM (FFM) only for now: the Native Image variant (truffle_backend=native, direct transitions,
# selected at image build time in a hosted Feature) is follow-up work (ledger, "Cells A").
genrule(
    name = "seam_jvm",
    srcs = ["//csv/native:csv.seam"],
    outs = ["cells_jvm.seam"],
    cmd = ("sed -e 's| java_package=dev.elide.truffledata.csv.kernel.generated java_class=CsvNative | " +
           "java_package=dev.elide.truffledata.csv.cells.generated java_class=CsvCellsJvm " +
           "truffle_cells=true truffle_backend=ffm |' $< > $@ && " +
           "grep -q '^module truffledata_csv .* java_class=CsvCellsJvm truffle_cells=true ' $@"),
)

myna_bindings(
    name = "bindings_jvm",
    abi = False,
    java_class = "CsvCellsJvm",
    java_package = "dev.elide.truffledata.csv.cells.generated",
    out = "generated/jvm",
    seam = ":seam_jvm",
    truffle = True,
)

java_library(
    name = "bindings",
    srcs = [
        "generated/jvm/CsvCellsJvmFFM.java",
        "generated/jvm/CsvCellsJvmTruffle.java",
    ],
    deps = [
        "//bazel:myna_compiler_sdk",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@myna//:truffle",
    ],
)

data_java_library(
    name = "cells",
    srcs = [
        "src/main/java/dev/elide/truffledata/csv/cells/CellsFfmIndexer.java",
        "src/main/java/dev/elide/truffledata/csv/cells/CsvCells.java",
    ],
    deps = [
        ":bindings",
        "//core",
        "//csv",
        "//csv/kernel:bindings",
        "//csv/kernel:jvm",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@myna//:truffle",
    ],
)
