load("@rules_graalvm//graalvm:defs.bzl", "native_image")
load("@rules_java//java:defs.bzl", "java_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:java.bzl", "data_java_library")
load("//bazel:jit.bzl", "LINUX_SVM_PLATFORMS", "LINUX_SVM_SDK", "TRUFFLE_JIT_CHECKS")

data_java_library(
    name = "acceptance",
    testonly = True,
    srcs = [
        "CompiledReads.java",
        "SvmAcceptance.java",
        "TestLanguage.java",
        "package-info.java",
    ],
    deps = [
        "//core",
        "//csv",
        "@maven//:org_graalvm_polyglot_polyglot",
        "@maven//:org_graalvm_truffle_truffle_api",
    ],
)

native_image(
    name = "native",
    testonly = True,
    exec_properties = {
        "EstimatedCPU": "8",
        "EstimatedMemory": "24GB",
    },
    executable_name = "csv_acceptance",
    extra_args = [
        "--gc=serial",
        "--initialize-at-build-time=dev.elide.truffledata",
        "-ea",
        "--parallelism=8",
        "-march=compatibility",
        "-H:+UnlockExperimentalVMOptions",
    ] + TRUFFLE_JIT_CHECKS + ["-H:-UnlockExperimentalVMOptions"],
    graalvm_sdk = LINUX_SVM_SDK,
    main_class = "dev.elide.truffledata.csv.tests.SvmAcceptance",
    optimization_mode = "2",
    tags = ["manual"],
    target_compatible_with = LINUX_SVM_PLATFORMS,
    deps = [
        ":acceptance",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

sh_test(
    name = "native_test",
    size = "large",
    srcs = ["native_test.sh"],
    args = ["$(rootpath :native)"],
    data = [":native"],
    tags = ["manual"],
    target_compatible_with = LINUX_SVM_PLATFORMS,
)

JVM_SRCS = [
    "ChunkedInput.java",
    "CommonsDifferentialTest.java",
    "CsvApiSurfaceTest.java",
    "CommonsFormats.java",
    "CommonsRoundTripTest.java",
    "CommonsScannerTest.java",
    "CsvBatchTest.java",
    "CsvFuzz.java",
    "CsvExportTest.java",
    "CsvFormatTest.java",
    "CsvFusedTest.java",
    "CsvIndexTest.java",
    "CsvInteropTest.java",
    "CsvKernelTest.java",
    "CsvMappingTest.java",
    "CsvNullsTest.java",
    "CsvPlanTest.java",
    "CsvReaderTest.java",
    "CsvRowScopeTest.java",
    "CsvScannerTest.java",
    "CsvTextTest.java",
    "Differential.java",
    "IndexedDifferentialTest.java",
    "ListSink.java",
    "NumbersDifferentialTest.java",
    "NumbersReference.java",
    "NumbersTest.java",
    "RecordGenerator.java",
    "CsvWriterTest.java",
    "Utf8Test.java",
]

JVM_CLASSES = [
    "CommonsDifferentialTest",
    "CsvApiSurfaceTest",
    "CommonsRoundTripTest",
    "CommonsScannerTest",
    "CsvBatchTest",
    "CsvExportTest",
    "CsvFormatTest",
    "CsvFusedTest",
    "CsvIndexTest",
    "CsvInteropTest",
    "CsvKernelTest",
    "CsvMappingTest",
    "CsvNullsTest",
    "CsvPlanTest",
    "CsvReaderTest",
    "CsvRowScopeTest",
    "CsvScannerTest",
    "CsvTextTest",
    "CsvWriterTest",
    "IndexedDifferentialTest",
    "NumbersDifferentialTest",
    "NumbersTest",
    "Utf8Test",
]

JVM_ARGS = [
    arg
    for name in JVM_CLASSES
    for arg in [
        "--class",
        "dev.elide.truffledata.csv." + name,
    ]
]

JVM_DEPS = [
    "//benchmarks/comparison:csv_fixtures",
    "//core",
    "//csv",
    "@maven//:org_apache_commons_commons_csv",
    "@maven//:org_graalvm_polyglot_polyglot",
    "@maven//:org_graalvm_truffle_truffle_api",
    "@maven//:org_jspecify_jspecify",
    "@maven//:org_junit_jupiter_junit_jupiter_api",
]

java_test(
    name = "jvm",
    srcs = JVM_SRCS,
    args = JVM_ARGS,
    jvm_flags = [
        "-Dpolyglot.engine.WarnInterpreterOnly=false",
        "-ea",
    ],
    main_class = "dev.elide.bazel.junit.BazelJUnitRunner",
    use_testrunner = False,
    runtime_deps = [
        "//bazel/junit:runner",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
    deps = JVM_DEPS,
)

# Myna 0.14.0 ABI classes of the native kernel (CsvNativeAbiTest): its FFM backend, the kernel and
# the other-ABI-class stub. Its own lane, since the pure-Java suites assert that no native backend
# service is on their class path.
java_test(
    name = "jvm_native_abi",
    srcs = ["CsvNativeAbiTest.java"],
    args = [
        "--class",
        "dev.elide.truffledata.csv.CsvNativeAbiTest",
    ],
    data = [
        "//csv/native:csv_shared.so",
        "//csv/native:other_abi_class.so",
        "//csv/native:other_abi_class_fingerprints",
    ],
    jvm_flags = [
        "--enable-native-access=ALL-UNNAMED",
        "-ea",
    ],
    main_class = "dev.elide.bazel.junit.BazelJUnitRunner",
    use_testrunner = False,
    runtime_deps = ["//bazel/junit:runner"],
    deps = [
        "//core",
        "//csv",
        "//csv/kernel:bindings",
        "//csv/kernel:jvm",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# Every suite again with the index path forced at every input size over 64-byte kernel calls
# (ForceIndex, registered by JUnit extension autodetection), so the unchanged scanner, reader,
# plan, Commons differential and mapped-input suites also check the index path and its fallback.
java_test(
    name = "jvm_indexed",
    size = "large",
    srcs = JVM_SRCS + ["ForceIndex.java"],
    args = JVM_ARGS,
    jvm_flags = [
        "-Dpolyglot.engine.WarnInterpreterOnly=false",
        "-Djunit.jupiter.extensions.autodetection.enabled=true",
        "-ea",
    ],
    main_class = "dev.elide.bazel.junit.BazelJUnitRunner",
    resource_strip_prefix = "csv/tests/indexed",
    resources = ["indexed/META-INF/services/org.junit.jupiter.api.extension.Extension"],
    use_testrunner = False,
    runtime_deps = [
        "//bazel/junit:runner",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
    deps = JVM_DEPS,
)
