module truffledata_csv abi=1 target=x86_64-unknown-linux-gnu java_package=dev.elide.truffledata.csv.kernel.generated java_class=CsvNative c_library=truffledata_csv c_library_static=true
# The integer protocol of every entry below (csv/native/api.cc, index.h; csv/native/README.md). C++
# keeps its index.h mirrors, asserted against seam.h in api.cc; Java uses CsvNativeConstants.
# A csv/native Kernel id (index.h `Kernel`): td_csv_kernel's request and result, td_csv_index's
# `kernel`. AUTO asks for the best kernel this CPU supports.
enum Kernel type=i32
  value auto = 0
  value scalar = 1
  value swar = 2
  value neon = 3
  value avx2 = 4
  value avx512 = 5
end
# td_csv_kernel: the requested kernel is unknown or unsupported on this CPU.
const KERNEL_UNSUPPORTED type=i32 value=-1
# td_csv_index `format`: delimiter | quote << 8 | quoting << 16; every higher bit is rejected.
flags Format type=i32
  range delimiter = 0..7
  range quote = 8..15
  bit quoting = 16
end
# td_csv_index `carry` (and the low byte of its result): the state that connects calls.
flags Carry type=i64
  bit inside = 0
  bit closing = 1
  bit quoted = 2
  bit escaped = 3
  bit unquoted = 4
end
# One `out` entry: the separator's offset in the call, and flags for the field it ends.
flags Entry type=u32
  range offset = 0..28
  bit unquoted = 29
  bit escaped = 30
  bit quoted = 31
end
# td_csv_index: a result is count << INDEX_COUNT_SHIFT | carry-out, or one of these errors.
const INDEX_COUNT_SHIFT type=u32 value=8
const INDEX_BAD_FORMAT type=i64 value=-1
const INDEX_BAD_KERNEL type=i64 value=-2
const INDEX_BAD_LENGTH type=i64 value=-3
const INDEX_BAD_CARRY type=i64 value=-4
# The most bytes one td_csv_index call indexes (entry offsets have 29 bits).
const MAX_CALL_BYTES type=u64 value=536870911
# td_csv_validate_utf8: the input is strict UTF-8 (otherwise the result is an offset).
const UTF8_VALID type=i64 value=-1
import fingerprint symbol=td_csv_fingerprint return=ptr<u8> error=no_failure native_leaf=true@explicit_contract
end
import kernel symbol=td_csv_kernel return=i32 enum=Kernel error=no_failure native_leaf=true@explicit_contract
  param requested type=i32 enum=Kernel
end
import index symbol=td_csv_index return=i64 error=no_failure native_leaf=false@explicit_contract
  param data type=ptr<u8> nullable=false ownership=borrowed access=read
  param length type=u64
  param out type=ptr<i32> nullable=false ownership=borrowed access=write
  param format type=i32 flags=Format
  param kernel type=i32 enum=Kernel
  param carry type=i64 flags=Carry
end
import index_leaf symbol=td_csv_index_leaf return=i64 error=no_failure native_leaf=true@explicit_contract
  param data type=ptr<u8> nullable=false ownership=borrowed access=read
  param length type=u64
  param out type=ptr<i32> nullable=false ownership=borrowed access=write
  param format type=i32 flags=Format
  param kernel type=i32 enum=Kernel
  param carry type=i64 flags=Carry
end
import validate_utf8 symbol=td_csv_validate_utf8 return=i64 error=no_failure native_leaf=false@explicit_contract
  param data type=ptr<u8> nullable=false ownership=borrowed access=read
  param length type=u64
end
