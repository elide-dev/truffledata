load("@rules_rust//rust:defs.bzl", "rust_static_library")

# Myna's myna-values (0.9.1) as a static library for JSON SVM images: SvmValueTape calls its
# myna_utf8_to_utf16_v2 for long strings (performance plan Task D1). The JVM shared library does
# not link it.
rust_static_library(
    name = "bridge",
    srcs = ["lib.rs"],
    crate_name = "truffledata_json_bridge",
    crate_root = "lib.rs",
    edition = "2024",
    link_deps = ["//protobuf-buffa/native:cpp_runtime"],
    rustc_flags = ["-Copt-level=3"],
    visibility = [
        "//json:__subpackages__",
        "//tools/release:__pkg__",
    ],
    deps = ["@crates//:myna-values"],
)
