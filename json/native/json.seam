  field index_retained_bytes type=u64 offset=32
  field index_peak_bytes type=u64 offset=40
  field index_allocations type=u64 offset=48
  field parser_input_capacity type=u64 offset=56
  field control_bytes type=u64 offset=64
  field text_table type=ptr<u64> offset=72
  field text_bytes type=u64 offset=80
end
