module truffledata_json abi=10 target=x86_64-unknown-linux-gnu java_package=dev.elide.truffledata.json.generated java_class=Json c_library=truffledata_json c_library_static=true

# The integer protocol of the C ABI (json/native/api.h). This seam is its single source: api.h,
# status.h, api.cc and the Java backends take every value below from the generated seam.h and
# JsonConstants. Enums are open sets: nothing checks a returned value against these lists.

# Status codes. No C++ exception crosses the generated C boundary. stream_empty/stream_truncated
# have the values of TD_YAML_STREAM_EMPTY/TD_YAML_STREAM_TRUNCATED (one stream contract, read by
# the shared tape/ TapeSession).
enum Status type=i32
  value ok = 0
  value argument = 1
  value limit = 2
  value allocation = 3
  value syntax = 4
  value internal = 5
  value contract = 6
  value text_too_small = 7
  value stream_empty = 8
  value stream_truncated = 9
end

# session_decode(_small) and stream_next flags (stream_next accepts only want_directories). Other
# bits are TD_JSON_ARGUMENT.
flags DecodeFlags type=u32
  bit want_text = 0
  bit utf16_input = 1
  bit latin1_input = 3
  bit validate_only = 4
  bit want_directories = 5
end

# session_decode_small accepts at most this many input bytes.
const CRITICAL_LIMIT type=u32 value=4096
# The largest max_depth any decode or session accepts.
const MAX_DEPTH type=u32 value=128
# Typed plans hold at most this many records, each of at most MAX_RECORD_FIELDS fields.
const MAX_PLAN_RECORDS type=u32 value=65536
const MAX_RECORD_FIELDS type=u32 value=64
# Maximum record nesting of a typed plan; the root record alone has depth 1.
const MAX_PLAN_DEPTH type=u32 value=32
# JsonScalarField.child of a field that is not a record.
const NO_CHILD type=u32 value=0xFFFFFFFF
# TapeView.version of a compact tape (td_tape_view, TD_TAPE_VIEW_VERSION in tape/native/ctape.h).
const TAPE_VIEW_VERSION type=u32 value=1

# TapeView.flags (TD_TAPE_* in tape/native/ctape.h).
flags TapeFlags type=u32
  bit nonfinite = 0
  bit has_meta = 1
  bit no_directories = 2
  bit yaml = 3
end

# Typed plans: JsonScalarField.kind, .length_unit, .float_bits and .flags.
enum FieldKind type=u32
  value boolean = 0
  value int64 = 1
  value uint64 = 2
  value float64 = 3
  value string = 4
  value record = 5
end
enum LengthUnit type=u32
  value unconstrained = 0
  value utf16 = 1
  value scalar_values = 2
end
# binary32 requires an exactly representable binary32 value; unspecified is binary64.
enum FloatWidth type=u32
  value unspecified = 0
  value binary32 = 32
  value binary64 = 64
end
flags FieldFlags type=u32
  bit required = 0
  bit nullable = 1
  bit repeated = 2
end

# Thread-confined native session and stream handles (api.h).
opaque JsonSession
opaque JsonStream
