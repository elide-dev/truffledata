# session_decode(_small) and stream_next write a *borrowed* JsonResult and overwrite the struct
# they are given without checking for a live owner, so their `result` stays ptr<void>: typed
# ptr<JsonResult>, the cells (json/cells/ownership.seam, where JsonResult is a resource) would
# accept a live JsonResult owner there and the call would overwrite it.
import session_decode symbol=td_json_session_decode return=i32 enum=Status error=no_failure native_leaf=false@explicit_contract
  param session type=ptr<JsonSession> nullable=false ownership=borrowed access=read_write
  param data type=ptr<u8> nullable=false ownership=borrowed access=read
  param length type=u64
  param flags type=u32 flags=DecodeFlags
  param text_out type=ptr<u8> nullable=true ownership=borrowed access=read_write
  param text_capacity type=u64
  param result type=ptr<void> nullable=false ownership=borrowed access=read_write
end
