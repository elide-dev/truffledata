load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "decoder",
    hdrs = [
        "decoder.h",
        "memory.h",
    ],
    copts = ["-std=c++17"],
    deps = [
        "@myna//:values_headers",
        "@simdjson",
    ],
)

cc_test(
    name = "test",
    srcs = ["decoder_test.cc"],
    copts = ["-std=c++17"],
    deps = [":decoder"],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

genrule(
    name = "bindings",
    srcs = ["json.seam"],
    outs = [
        "generated/JsonFFM.java",
        "generated/Json.java",
        "generated/JsonForeignFeature.java",
        "generated/seam.rs",
        "generated/seam.h",
        "generated/seam.json",
        "generated/seam.abi",
        "generated/seam.ll",
    ],
    cmd = "$(location @myna//:generator) generate $(location json.seam) --out $(RULEDIR)/generated --target " + select({
        "@platforms//os:macos": "aarch64-apple-darwin",
        ":linux_arm64": "aarch64-unknown-linux-gnu",
        "//conditions:default": "x86_64-unknown-linux-gnu",
    }),
    tools = ["@myna//:generator"],
)

cc_library(
    name = "truffledata_json",
    srcs = ["api.cc"],
    hdrs = [
        "api.h",
        "generated/seam.h",
    ],
    copts = [
        "-std=c++17",
        "-O3",
    ],
    visibility = ["//visibility:public"],
    deps = [":decoder"],
)

cc_test(
    name = "api_test",
    srcs = ["api_test.cc"],
    copts = ["-std=c++17"],
    deps = [
        ":truffledata_json",
        "@myna//:values_headers",
    ],
)

filegroup(
    name = "java_bindings",
    srcs = [
        "generated/Json.java",
        "generated/JsonFFM.java",
    ],
    visibility = ["//visibility:public"],
)
