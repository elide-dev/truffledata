load("//tools/fuzz:defs.bzl", "native_fuzzer")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//bazel:myna.bzl", "myna_bindings", "myna_other_class_stub")

cc_library(
    name = "decoder",
    hdrs = [
        "decoder.h",
        "decoder_common.h",
        "parser_pool.h",
        "session.h",
        "stage1.h",
        "stage2.h",
        "status.h",
        "stream.h",
    ],
    copts = ["-std=c++17"],
    deps = [
        "//bazel:unicode",
        "//tape/native:tape",
        "@myna//:values_headers",
        "@simdjson",
    ],
)

cc_test(
    name = "test",
    srcs = ["decoder_test.cc", "testing/ondemand_decoder.h"],
    copts = ["-std=c++17"],
    deps = [
        ":myna_oracle",
        ":decoder",
        "//tape/native:testing",
    ],
)

# The previous Myna producer is a test-only differential oracle.
cc_test(
    name = "myna_oracle_test",
    srcs = ["testing/myna_oracle_test.cc"],
    copts = ["-std=c++17"],
    deps = [
        ":myna_oracle",
        ":decoder",
        "//tape/native:testing",
    ],
)

cc_library(
    name = "myna_oracle",
    testonly = True,
    hdrs = ["testing/myna_oracle.h", "testing/ondemand_pool.h"],
    copts = ["-std=c++17"],
    deps = [":decoder"],
)

myna_bindings(
    name = "bindings",
    java_class = "Json",
    java_package = "dev.elide.truffledata.json.generated",
    seam = "json.seam",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "truffledata_json",
    srcs = ["api.cc"],
    hdrs = [
        "api.h",
        "generated/seam.h",
    ],
    copts = [
        "-std=c++17",
        "-O3",
    ],
    linkopts = select({
        "@platforms//os:macos": ["-lc++"],
        "//conditions:default": [
            "-lc++",
            "-lc++abi",
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":decoder",
        ":typed",
    ],
)

# The C ABI and compact-tape simdutf transcoder for static images.
cc_library(
    name = "svm",
    visibility = ["//visibility:public"],
    deps = [
        ":truffledata_json",
    ],
)

cc_test(
    name = "api_test",
    srcs = ["api_test.cc"],
    copts = ["-std=c++17"],
    deps = [
        ":myna_oracle",
        ":truffledata_json",
        "@myna//:values_headers",
    ],
)

cc_test(
    name = "stream_test",
    srcs = ["stream_test.cc"],
    copts = ["-std=c++17"],
    deps = [
        ":truffledata_json",
        "@myna//:values_headers",
    ],
)

filegroup(
    name = "java_bindings",
    srcs = [
        "generated/Json.java",
        "generated/JsonAbi.java",
        "generated/JsonFFM.java",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "json_shared.so",
    srcs = ["api.cc"],
    copts = [
        "-std=c++17",
        "-O3",
    ],
    linkopts = select({
        # The macos-aarch64 release attachment (tools/release) is loaded through @rpath.
        "@platforms//os:macos": ["-Wl,-install_name,@rpath/libtruffledata_json.dylib", "-Wl,-dead_strip_dylibs"],
        "//conditions:default": [],
    }),
    linkshared = True,
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [":truffledata_json"],
)

filegroup(
    name = "native_resources",
    srcs = ["generated/META-INF/native-image/dev.elide.myna/dev.elide.truffledata.json.generated.Json/native-image.properties"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "descriptor",
    srcs = ["generated/seam.json"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "typed",
    hdrs = [
        "generated/seam.h",
        "typed.h",
    ],
    copts = ["-std=c++17"],
    deps = [
        ":decoder",
        "//bazel:unicode",
    ],
)

cc_test(
    name = "typed_test",
    srcs = ["typed_test.cc"],
    copts = ["-std=c++17"],
    deps = [":typed"],
)

cc_test(
    name = "unicode_test",
    srcs = ["unicode_test.cc"],
    copts = ["-std=c++17"],
    deps = [
        ":typed",
        "//protobuf-buffa/native:truffledata_buffa",
    ],
)

cc_test(
    name = "stage2_test",
    srcs = ["stage2_test.cc", "testing/ondemand_decoder.h"],
    deps = [":decoder", "//tape/native:testing"],
)

cc_test(
    name = "shape_fuzz_test",
    srcs = ["shape_fuzz_test.cc"],
    deps = [":decoder"],
)

cc_test(
    name = "duplicate_probe",
    srcs = ["duplicate_probe.cc"],
    tags = ["manual"],
    deps = [":decoder", "//tape/native:testing"],
)

cc_test(
    name = "text_fusion_test",
    srcs = ["text_fusion_test.cc", "testing/text_fusion_session.h", "testing/text_fusion_stage2.h"],
    deps = [":decoder", "//tape/native:testing"],
)

cc_test(
    name = "text_fusion_probe",
    srcs = ["text_fusion_probe.cc", "testing/text_fusion_session.h", "testing/text_fusion_stage2.h"],
    tags = ["manual"],
    deps = [":decoder", "//tape/native:testing"],
)

cc_test(
    name = "stage2_probe",
    srcs = ["stage2_probe.cc", "testing/stage2_baseline_probe.h", "testing/ondemand_decoder.h", "testing/ondemand_pool.h"],
    tags = ["manual"],
    deps = [":decoder", "//tape/native:testing"],
)

cc_test(
    name = "stream_probe",
    srcs = ["stream_probe.cc", "testing/ondemand_session.h", "testing/ondemand_stream.h", "testing/ondemand_decoder.h"],
    tags = ["manual"],
    deps = [":decoder", "//tape/native:testing"],
)

cc_test(
    name = "typed_stage2_test",
    srcs = ["typed_stage2_test.cc", "testing/typed_ondemand.h"],
    deps = [":typed"],
)

cc_test(
    name = "typed_probe",
    srcs = ["typed_probe.cc", "testing/typed_ondemand.h"],
    tags = ["manual"],
    deps = [":typed"],
)

genrule(
    name = "isa_variants",
    testonly = True,
    srcs = ["stage2.h", "testing/make_isa_probe.py"],
    outs = ["testing/isa_variants.h"],
    cmd = "python3 $(location testing/make_isa_probe.py) $(location stage2.h) $@",
)

cc_test(
    name = "isa_probe",
    srcs = ["isa_probe.cc", ":isa_variants"],
    tags = ["manual"],
    deps = [":decoder", "//tape/native:testing"],
)

# buildifier: disable=duplicated-name
native_fuzzer(
    name = "session",
    src = "session_fuzz.cc",
    deps = [":decoder"],
)

# Test-only: a library reporting the fingerprint of the ABI class this host is not, which JSON's
# bindings must reject (and the per-class fingerprints the bindings' constants are checked against).
myna_other_class_stub(
    name = "other_abi_class",
    abi = ":generated/abi",
    symbol = "td_json_fingerprint",
    visibility = ["//json/tests:__pkg__"],
)
