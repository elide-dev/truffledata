load("@rules_graalvm//graalvm:defs.bzl", "native_image")
load("@rules_java//java:defs.bzl", "java_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:java.bzl", "data_java_library")
load("//bazel:jit.bzl", "LINUX_SVM_PLATFORMS", "LINUX_SVM_SDK", "TRUFFLE_JIT_CHECKS")

data_java_library(
    name = "acceptance",
    testonly = True,
    srcs = [
        "CompiledArrayReads.java",
        "CompiledReads.java",
        "SvmAcceptance.java",
        "TestLanguage.java",
        "package-info.java",
    ],
    deps = [
        "//core",
        "//json",
        "//json:bindings",
        "//json:jvm",
        "@maven//:org_graalvm_polyglot_polyglot",
        "@maven//:org_graalvm_sdk_nativeimage",
        "@maven//:org_graalvm_sdk_word",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@myna//:values",
    ],
    # The cells image (//json/cells/tests:native) reruns this suite on the cells route.
    visibility = ["//json/cells/tests:__pkg__"],
)

native_image(
    name = "native",
    testonly = True,
    cc_deps = ["//json/native:svm"],
    exec_properties = {
        "EstimatedCPU": "8",
        "EstimatedMemory": "24GB",
    },
    executable_name = "json_acceptance",
    extra_args = [
        "--gc=serial",
        "--initialize-at-build-time=dev.elide.truffledata",
        "-ea",
        "--parallelism=8",
        "-march=compatibility",
        "-H:+UnlockExperimentalVMOptions",
    ] + TRUFFLE_JIT_CHECKS + ["-H:-UnlockExperimentalVMOptions"],
    graalvm_sdk = LINUX_SVM_SDK,
    main_class = "dev.elide.truffledata.json.tests.SvmAcceptance",
    optimization_mode = "2",
    tags = ["manual"],
    target_compatible_with = LINUX_SVM_PLATFORMS,
    deps = [
        ":acceptance",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

sh_test(
    name = "native_test",
    size = "large",
    srcs = ["native_test.sh"],
    args = ["$(rootpath :native)"],
    data = [":native"],
    tags = ["manual"],
    target_compatible_with = LINUX_SVM_PLATFORMS,
)

java_test(
    name = "jvm",
    srcs = [
        "FfmAcceptanceTest.java",
        "JsonExportTest.java",
        "JsonInteropTest.java",
        "JvmScopedTest.java",
    ],
    args = [
        "--class",
        "dev.elide.truffledata.json.tests.FfmAcceptanceTest",
        "--class",
        "dev.elide.truffledata.json.tests.JsonExportTest",
        "--class",
        "dev.elide.truffledata.json.tests.JsonInteropTest",
        "--class",
        "dev.elide.truffledata.json.tests.JvmScopedTest",
    ],
    data = [
        "//json/native:json_shared.so",
        "//json/native:other_abi_class.so",
        "//json/native:other_abi_class_fingerprints",
    ],
    jvm_flags = [
        "--enable-native-access=ALL-UNNAMED",
        "-Dpolyglot.engine.WarnInterpreterOnly=false",
        "-ea",
    ],
    main_class = "dev.elide.bazel.junit.BazelJUnitRunner",
    use_testrunner = False,
    runtime_deps = [
        "//bazel/junit:runner",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
    deps = [
        "//core",
        "//json",
        "//json:bindings",
        "//json:jvm",
        "@maven//:com_google_code_gson_gson",
        "@maven//:org_graalvm_polyglot_polyglot",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@myna//:values",
    ],
)

# The JVM suites, rerun on the JSON cells route by //json/cells/tests:jvm.
exports_files(
    [
        "FfmAcceptanceTest.java",
        "JsonExportTest.java",
        "JsonInteropTest.java",
        "JvmScopedTest.java",
        "native_test.sh",
    ],
    visibility = ["//json/cells/tests:__pkg__"],
)
