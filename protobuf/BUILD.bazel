load("@rules_java//java:defs.bzl", "java_binary")
load("//bazel:java.bzl", "data_java_library")

package(default_visibility = ["//visibility:public"])

data_java_library(
    name = "protobuf",
    srcs = [
        "src/main/java/dev/elide/truffledata/protobuf/NativeMetadata.java",
        "src/main/java/dev/elide/truffledata/protobuf/ProtobufAdapter.java",
        "src/main/java/dev/elide/truffledata/protobuf/ProtovalidateContracts.java",
        "src/main/java/dev/elide/truffledata/protobuf/package-info.java",
    ],
    deps = [
        "//core",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:org_graalvm_truffle_truffle_api",
    ],
)

filegroup(
    name = "sources",
    srcs = glob(["src/main/java/**/*.java"]),
)

exports_files(["BUILD.bazel"])

java_binary(
    name = "native_metadata",
    main_class = "dev.elide.truffledata.protobuf.NativeMetadata",
    runtime_deps = [":protobuf"],
)
