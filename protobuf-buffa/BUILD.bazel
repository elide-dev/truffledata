load("@rules_java//java:defs.bzl", "java_library")
load("//bazel:java.bzl", "data_java_library")

package(default_visibility = ["//visibility:public"])

# Myna output is generated as-is; our adapters remain NullAway/JSpecify checked.
java_library(
    name = "bindings",
    srcs = ["//protobuf-buffa/native:java_bindings"],
    resource_strip_prefix = "protobuf-buffa/native/generated",
    resources = ["//protobuf-buffa/native:native_resources"],
    deps = [
        "//bazel:myna_compiler_sdk",
        "@maven//:org_graalvm_sdk_nativeimage",
        "@maven//:org_graalvm_sdk_word",
    ],
)

data_java_library(
    name = "protobuf-buffa",
    srcs = [
        "src/main/java/dev/elide/truffledata/buffa/BorrowedBytes.java",
        "src/main/java/dev/elide/truffledata/buffa/BuffaFeature.java",
        "src/main/java/dev/elide/truffledata/buffa/BuffaJvm.java",
        "src/main/java/dev/elide/truffledata/buffa/BuffaPlan.java",
        "src/main/java/dev/elide/truffledata/buffa/BuffaSvm.java",
        "src/main/java/dev/elide/truffledata/buffa/BuffaWire.java",
        "src/main/java/dev/elide/truffledata/buffa/FfmBackend.java",
        "src/main/java/dev/elide/truffledata/buffa/NativeSchema.java",
        "src/main/java/dev/elide/truffledata/buffa/ScalarRow.java",
        "src/main/java/dev/elide/truffledata/buffa/SvmBackend.java",
        "src/main/java/dev/elide/truffledata/buffa/TypedArray.java",
        "src/main/java/dev/elide/truffledata/buffa/TypedMessage.java",
        "src/main/java/dev/elide/truffledata/buffa/TypedRow.java",
        "src/main/java/dev/elide/truffledata/buffa/ViewOwner.java",
        "src/main/java/dev/elide/truffledata/buffa/WireField.java",
        "src/main/java/dev/elide/truffledata/buffa/WireInput.java",
        "src/main/java/dev/elide/truffledata/buffa/WireMessage.java",
        "src/main/java/dev/elide/truffledata/buffa/package-info.java",
    ],
    deps = [
        ":bindings",
        "//core",
        "//protobuf-runtime",
        "@maven//:org_graalvm_sdk_nativeimage",
        "@maven//:org_graalvm_sdk_word",
        "@maven//:org_graalvm_truffle_truffle_api",
    ],
)

filegroup(
    name = "sources",
    srcs = glob(["src/main/java/**/*.java"]),
)

exports_files(["BUILD.bazel"])
