load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_static_library", "rust_test")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

genrule(
    name = "bindings",
    srcs = ["buffa.seam"],
    outs = [
        "generated/BuffaFFM.java",
        "generated/Buffa.java",
        "generated/BuffaForeignFeature.java",
        "generated/seam.rs",
        "generated/seam.h",
        "generated/seam.json",
        "generated/seam.abi",
        "generated/seam.ll",
        "generated/META-INF/native-image/dev.elide.myna/dev.elide.truffledata.buffa.generated.Buffa/native-image.properties",
    ],
    cmd = "$(location @myna//:generator) generate $(location buffa.seam) --out $(RULEDIR)/generated --target " + select({
        "@platforms//os:macos": "aarch64-apple-darwin",
        ":linux_arm64": "aarch64-unknown-linux-gnu",
        "//conditions:default": "x86_64-unknown-linux-gnu",
    }),
    tools = ["@myna//:generator"],
)

filegroup(
    name = "java_bindings",
    srcs = [
        "generated/Buffa.java",
        "generated/BuffaFFM.java",
    ],
)

filegroup(
    name = "header",
    srcs = ["generated/seam.h"],
)

rust_library(
    name = "lib",
    srcs = [
        "generated/seam.rs",
        "lib.rs",
        "typed.rs",
        "typed_json.rs",
        "typed_view.rs",
        "typed_view_tests.rs",
        "typed_wkt.rs",
        "unicode.rs",
    ],
    crate_name = "truffledata_buffa",
    crate_root = "lib.rs",
    edition = "2024",
    rustc_flags = ["-Copt-level=3"],
    deps = [
        "@crates//:buffa",
        "@crates//:bytes",
        "@crates//:serde_json",
        "@crates//:simdutf",
    ],
)

rust_static_library(
    name = "truffledata_buffa",
    srcs = [
        "generated/seam.rs",
        "lib.rs",
        "typed.rs",
        "typed_json.rs",
        "typed_view.rs",
        "typed_view_tests.rs",
        "typed_wkt.rs",
        "unicode.rs",
    ],
    crate_name = "truffledata_buffa",
    crate_root = "lib.rs",
    edition = "2024",
    link_deps = [":cpp_runtime"],
    rustc_flags = ["-Copt-level=3"],
    deps = [
        "@crates//:buffa",
        "@crates//:bytes",
        "@crates//:serde_json",
        "@crates//:simdutf",
    ],
)

rust_shared_library(
    name = "shared",
    srcs = [
        "generated/seam.rs",
        "lib.rs",
        "typed.rs",
        "typed_json.rs",
        "typed_view.rs",
        "typed_view_tests.rs",
        "typed_wkt.rs",
        "unicode.rs",
    ],
    crate_name = "truffledata_buffa",
    crate_root = "lib.rs",
    edition = "2024",
    rustc_flags = ["-Copt-level=3"],
    deps = [
        "@crates//:buffa",
        "@crates//:bytes",
        "@crates//:serde_json",
        "@crates//:simdutf",
    ],
)

rust_test(
    name = "test",
    crate = ":lib",
)

exports_files(["Cargo.toml"])

# Rust bundles simdutf's native objects; its final consumers still need the C++ runtime.
# Preserve that requirement in CcInfo for Native Image's cc_deps, not just Cargo linkage.
cc_library(
    name = "cpp_runtime",
    linkopts = select({
        "@platforms//os:macos": ["-lc++"],
        "//conditions:default": [
            "-lc++",
            "-lc++abi",
        ],
    }),
)

filegroup(
    name = "native_resources",
    srcs = ["generated/META-INF/native-image/dev.elide.myna/dev.elide.truffledata.buffa.generated.Buffa/native-image.properties"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "descriptor",
    srcs = ["generated/seam.json"],
    visibility = ["//visibility:public"],
)
