load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_static_library", "rust_test")
load("//bazel:myna.bzl", "myna_bindings")

package(default_visibility = ["//visibility:public"])

myna_bindings(
    name = "bindings",
    java_class = "Buffa",
    java_package = "dev.elide.truffledata.buffa.generated",
    seam = "buffa.seam",
)

filegroup(
    name = "java_bindings",
    srcs = [
        "generated/Buffa.java",
        "generated/BuffaAbi.java",
        "generated/BuffaFFM.java",
    ],
)

filegroup(
    name = "header",
    srcs = ["generated/seam.h"],
)

rust_library(
    name = "lib",
    srcs = [
        "generated/seam.rs",
        "lib.rs",
        "slab.rs",
        "slab_tests.rs",
        "typed.rs",
        "typed_json.rs",
        "typed_wkt.rs",
        "unicode.rs",
    ],
    crate_name = "truffledata_buffa",
    crate_root = "lib.rs",
    edition = "2024",
    rustc_flags = ["-Copt-level=3"],
    deps = [
        "@crates//:buffa",
        "@crates//:bytes",
        "@crates//:serde_json",
        "@crates//:simdutf",
    ],
)

rust_static_library(
    name = "truffledata_buffa",
    srcs = [
        "generated/seam.rs",
        "lib.rs",
        "slab.rs",
        "slab_tests.rs",
        "typed.rs",
        "typed_json.rs",
        "typed_wkt.rs",
        "unicode.rs",
    ],
    crate_name = "truffledata_buffa",
    crate_root = "lib.rs",
    edition = "2024",
    link_deps = [":cpp_runtime"],
    rustc_flags = ["-Copt-level=3"],
    deps = [
        "@crates//:buffa",
        "@crates//:bytes",
        "@crates//:serde_json",
        "@crates//:simdutf",
    ],
)

rust_shared_library(
    name = "shared",
    srcs = [
        "generated/seam.rs",
        "lib.rs",
        "slab.rs",
        "slab_tests.rs",
        "typed.rs",
        "typed_json.rs",
        "typed_wkt.rs",
        "unicode.rs",
    ],
    crate_name = "truffledata_buffa",
    crate_root = "lib.rs",
    edition = "2024",
    # The macos-aarch64 release attachment (tools/release) is loaded through @rpath.
    rustc_flags = ["-Copt-level=3"] + select({
        "@platforms//os:macos": ["-Clink-arg=-Wl,-install_name,@rpath/libtruffledata_buffa.dylib"],
        "//conditions:default": [],
    }),
    deps = [
        "@crates//:buffa",
        "@crates//:bytes",
        "@crates//:serde_json",
        "@crates//:simdutf",
    ],
)

rust_test(
    name = "test",
    size = "medium",
    crate = ":lib",
    # slab_tests.rs checks the Task A1 golden slabs.
    data = ["//protobuf-runtime:golden_slabs"],
)

exports_files([
    "Cargo.toml",
    # The protobuf-buffa-cells bindings are generated from a seam derived from this one.
    "buffa.seam",
])

# Rust bundles simdutf's native objects; its final consumers still need the C++ runtime.
# Preserve that requirement in CcInfo for Native Image's cc_deps, not just Cargo linkage.
cc_library(
    name = "cpp_runtime",
    linkopts = select({
        "@platforms//os:macos": ["-lc++"],
        "//conditions:default": [
            "-lc++",
            "-lc++abi",
        ],
    }),
)

filegroup(
    name = "native_resources",
    srcs = ["generated/META-INF/native-image/dev.elide.myna/dev.elide.truffledata.buffa.generated.Buffa/native-image.properties"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "descriptor",
    srcs = ["generated/seam.json"],
    visibility = ["//visibility:public"],
)
