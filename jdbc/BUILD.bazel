load("//bazel:java.bzl", "data_java_library")

package(default_visibility = ["//visibility:public"])

data_java_library(
    name = "jdbc",
    srcs = [
        "src/main/java/dev/elide/truffledata/jdbc/JdbcAdapter.java",
        "src/main/java/dev/elide/truffledata/jdbc/JdbcCancellation.java",
        "src/main/java/dev/elide/truffledata/jdbc/JdbcConsumptionLimits.java",
        "src/main/java/dev/elide/truffledata/jdbc/JdbcContracts.java",
        "src/main/java/dev/elide/truffledata/jdbc/JdbcCursor.java",
        "src/main/java/dev/elide/truffledata/jdbc/JdbcQueryOptions.java",
        "src/main/java/dev/elide/truffledata/jdbc/JdbcSource.java",
        "src/main/java/dev/elide/truffledata/jdbc/JdbcValues.java",
        "src/main/java/dev/elide/truffledata/jdbc/SqliteSource.java",
        "src/main/java/dev/elide/truffledata/jdbc/package-info.java",
    ],
    deps = [
        "//core",
        "@maven//:org_graalvm_truffle_truffle_api",
    ],
)

filegroup(
    name = "sources",
    srcs = glob(["src/main/java/**/*.java"]),
)

exports_files(["BUILD.bazel"])
