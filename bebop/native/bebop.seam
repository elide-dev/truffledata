  value timestamp = 13
  value duration = 14
  value enum_member = 15
  value set_order = 16
  value map_order = 17
  value map_duplicate = 18
  value unknown_tag = 19
  value field_range = 20
  value unknown_branch = 21
  value branch_range = 22
  value trailing = 23
  value byte_limit = 24
  value control_reserved = 25
  value control_width = 26
  value directory_truncated = 27
  value directory_order = 28
  value directory_rank = 29
  value directory_empty_block = 30
  value directory_tag_256 = 31
  value directory_canonical = 32
  value index_size = 33
  value payload_no_directory = 34
  value width_minimal = 35
  value boundary = 36
  value utc_offset = 37
  value program = 255
end
