load("//bazel:java.bzl", "data_java_library")

# Bebop (2026 indexed wire layout): general and strict-profile encoding and decoding, and bounded
# bulk views over validated bytes. Pure Java; one jar for the JVM and Native Image.
data_java_library(
    name = "bebop",
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//core",
        "@maven//:org_graalvm_truffle_truffle_api",
    ],
)

filegroup(
    name = "sources",
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//tests:__pkg__"],
)
