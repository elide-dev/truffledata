load("@rules_graalvm//graalvm:defs.bzl", "native_image")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:java.bzl", "data_java_library")
load("//bazel:jit.bzl", "TRUFFLE_JIT_CHECKS")

# Deliberately unsafe code is isolated from every positive test and publication.
data_java_library(
    name = "probe",
    testonly = True,
    srcs = [
        "BlocklistProbe.java",
        "NeverCompileProbe.java",
        "ProbeLanguage.java",
        "package-info.java",
    ],
    deps = [
        "@maven//:org_graalvm_polyglot_polyglot",
        "@maven//:org_graalvm_truffle_truffle_api",
    ],
)

native_image(
    name = "native",
    testonly = True,
    exec_properties = {
        "EstimatedCPU": "8",
        "EstimatedMemory": "24GB",
    },
    executable_name = "blocklist-probe",
    extra_args = [
        "--parallelism=8",
        "--initialize-at-build-time=dev.elide.truffledata.probe",
        "-H:+UnlockExperimentalVMOptions",
    ] + TRUFFLE_JIT_CHECKS + [
        "-H:-UnlockExperimentalVMOptions",
    ],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    main_class = "dev.elide.truffledata.probe.BlocklistProbe",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    workspace_tmp = True,
    deps = [
        ":probe",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

native_image(
    name = "never_compile",
    testonly = True,
    exec_properties = {
        "EstimatedCPU": "8",
        "EstimatedMemory": "24GB",
    },
    executable_name = "never-compile-probe",
    extra_args = [
        "--parallelism=8",
        "--initialize-at-build-time=dev.elide.truffledata.probe",
        "-H:+UnlockExperimentalVMOptions",
    ] + TRUFFLE_JIT_CHECKS + [
        "-H:-UnlockExperimentalVMOptions",
    ],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    main_class = "dev.elide.truffledata.probe.NeverCompileProbe",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    workspace_tmp = True,
    deps = [
        ":probe",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

data_java_library(
    name = "stock_probe",
    testonly = True,
    srcs = [
        "ProbeLanguage.java",
        "StockParseProbe.java",
        "package-info.java",
    ],
    deps = [
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:org_graalvm_polyglot_polyglot",
        "@maven//:org_graalvm_truffle_truffle_api",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

native_image(
    name = "stock_parse",
    testonly = True,
    exec_properties = {
        "EstimatedCPU": "4",
        "EstimatedMemory": "16GB",
    },
    executable_name = "stock-parse-probe",
    extra_args = [
        "--gc=serial",
        "--add-exports=org.graalvm.truffle.runtime/com.oracle.truffle.runtime=ALL-UNNAMED",
        "--parallelism=4",
        "-march=compatibility",
        "--initialize-at-build-time=dev.elide.truffledata.probe",
        "-H:+UnlockExperimentalVMOptions",
    ] + TRUFFLE_JIT_CHECKS + ["-H:-UnlockExperimentalVMOptions"],
    graalvm_sdk = "@graalvm_linux_amd64//:gvm",
    main_class = "dev.elide.truffledata.probe.StockParseProbe",
    optimization_mode = "2",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [":stock_probe"],
)

sh_test(
    name = "stock_parse_test",
    size = "large",
    srcs = ["stock_parse_test.sh"],
    args = ["$(location :stock_parse)"],
    data = [":stock_parse"],
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
