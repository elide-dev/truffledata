java_test(
    name = "test",
    size = "medium",
    args = [
        "--package",
        "dev.elide.truffledata",
        "--include-class",
        "dev.elide.truffledata.(Core|GeneratedCodec|ProtoDescriptors|ProtoNative|Jdbc|JdbcLifecycle|Protobuf|Polyglot|Policy|Contracts|Integration|JitMatrix)Test",
    ],
    data = [
        ":native_descriptors",
        ":validation_descriptors",
        "//bazel:java.bzl",
        "//core:sources",
        "//jdbc:sources",
        "//jdbc-mysql:sources",
        "//jdbc-postgresql:sources",
        "//jdbc-sqlite:sources",
        "//protobuf:sources",
        "//protobuf-runtime:sources",
    ],
    exec_properties = {
        "EstimatedCPU": "4",
        "EstimatedMemory": "6GB",
    },
    jvm_flags = [
        "-ea",
        "-Dtruffledata.strict=true",
        "--enable-native-access=ALL-UNNAMED",
        "-Dpolyglot.engine.WarnInterpreterOnly=false",
    ],
    main_class = "dev.elide.bazel.junit.BazelJUnitRunner",
    tags = [],
    use_testrunner = False,
    runtime_deps = [
        ":test_lib",
        "//bazel/junit:runner",
        "@maven//:com_h2database_h2",
        "@maven//:org_graalvm_js_js_language",
        "@maven//:org_graalvm_python_python_language",
        "@maven//:org_graalvm_python_python_resources",
        "@maven//:org_graalvm_truffle_truffle_runtime",
        "@maven//:org_xerial_sqlite_jdbc",
    ],
)

