genrule(
    name = "validation_descriptors",
    testonly = True,
    srcs = [
        "validation.proto",
        "@protovalidate_schema//file",
        "@protobuf//:descriptor_proto_srcs",
        "@protobuf//:well_known_type_protos",
    ],
    outs = ["validation.pb"],
    cmd = "$(location @protobuf//:protoc) --proto_path=tests --proto_path=$$(dirname $(location @protovalidate_schema//file)) --proto_path=$$(dirname $(location @protobuf//:descriptor_proto_srcs))/../.. --include_imports --descriptor_set_out=$@ $(location validation.proto)",
    tools = ["@protobuf//:protoc"],
)

java_test(
    name = "jit_matrix",
    size = "large",
    args = [
        "--package",
        "dev.elide.truffledata",
        "--include-class",
        "dev.elide.truffledata.JitMatrixTest",
    ],
    jvm_flags = [
        "-ea",
        "--enable-native-access=ALL-UNNAMED",
        "-Dtruffledata.requireCompiled=true",
        "-Dtruffledata.strict=true",
    ],
    main_class = "dev.elide.bazel.junit.BazelJUnitRunner",
    tags = ["jit"],
    use_testrunner = False,
    runtime_deps = [
        ":test_lib",
        "//bazel/junit:runner",
        "@maven//:org_graalvm_truffle_truffle_runtime",
    ],
)

proto_contract_library(
    name = "native_contracts",
    testonly = True,
    srcs = [
        "native_proto2.proto",
        "native_proto3.proto",
    ],
    proto_path = "tests",
)

genrule(
    name = "native_descriptors",
    testonly = True,
    srcs = [
        "native_proto2.proto",
        "native_proto3.proto",
    ],
    outs = ["native.pb"],
    cmd = "$(location @protobuf//:protoc) --proto_path=tests --include_imports --descriptor_set_out=$@ $(SRCS)",
    tools = ["@protobuf//:protoc"],
)

proto_library(
    name = "wkt_proto",
