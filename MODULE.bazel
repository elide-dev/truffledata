# ---- C/C++: elide-dev/toolchain (LLVM 23, libc++, lld, ThinLTO bitcode sysroots).
ELIDE_TOOLCHAIN = "2026.11.1"

ELIDE_TOOLCHAIN_BUNDLES = {
    "darwin_arm64": ("darwin-arm64", "37e56bad391f8397c99951a529ef84bdc99c9d19bdf91edbc153b5bdecb69e88"),
    "linux_amd64": ("linux-amd64", "4610627acc96f647776fd4256b3c1fce04c14b2757df692d8923ec299aed0e58"),
    "linux_arm64": ("linux-arm64", "b6c73becf52e8491c0aad2d1bb5ac6185a7e0c931e1206c62652b1e47fb26785"),
}

[http_archive(
    name = "elide_toolchain_" + key,
    build_file = "//bazel:elide_toolchain.BUILD",
    # `cc`: bin/clang behind the macOS SDK selection (bazel/patches/elide-toolchain-cc.patch).
    patch_cmds = ["chmod +x cc"] + ([
        # Linux headers have case-distinct names. A case-insensitive output base silently
        # overwrites them, splitting the RBE cache from Linux CI (and corrupting the sysroot).
        # Catch direct Bazel / output-base overrides that bypass the tools/bazel launcher.
        "probe=$(mktemp -d .komodo-case.XXXXXX); touch \"$probe/lower\"; " +
        "if [ -e \"$probe/LOWER\" ]; then rm \"$probe/lower\"; rmdir \"$probe\"; " +
        "echo 'Linux toolchains require a case-sensitive Bazel output base. Use Bazelisk with tools/bazel; see docs/BAZEL.md.' >&2; exit 1; fi; " +
        "rm \"$probe/lower\"; rmdir \"$probe\"",
    ] if key.startswith("linux_") else []),
    patch_strip = 1,
    patches = ["//bazel/patches:elide-toolchain-cc.patch"],
    sha256 = sha,
    strip_prefix = "elide-toolchain",
    urls = [
        "https://github.com/elide-dev/toolchain/releases/download/v%s/elide-toolchain-%s-%s.tar.xz" % (ELIDE_TOOLCHAIN, ELIDE_TOOLCHAIN, bundle),
        "https://static.elideusercontent.com/toolchain/%s/elide-toolchain-%s-%s.tar.xz" % (ELIDE_TOOLCHAIN, ELIDE_TOOLCHAIN, bundle),
    ],
) for key, (bundle, sha) in ELIDE_TOOLCHAIN_BUNDLES.items()]

