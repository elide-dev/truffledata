GRAALVM = "25.5.5-elide.27"

GRAALVM_DISTS = {
    "macos-aarch64": "e8ece6d4c8f3f1bc582d447ec36e7ade69d9cf4fc0e30c58bc40af39a9541f0c",
    "linux-x64": "b6d316ed0b81354949704afe632e1e2a1551d637736df5b6b03088cc5b09c852",
    "linux-aarch64": "c37b539081b55b2eb99abc593d06c037ec2421c2aa71aa8430c2d0b0a94b4ec8",
}

# The fork names its archives macos-aarch64, linux-amd64 and linux-aarch64.
GRAALVM_ARCHIVES = {key: key.replace("x64", "amd64") for key in GRAALVM_DISTS}

# The EE toolchain profile (docs/NATIVE_BENCHMARKS.md): the fork's Oracle GraalVM overlay of the same release, the test and
# run runtime under --config=ee (compilation stays on CE). Its budgets and graph expectations are tracked separately.
GRAALVM_EE_DISTS = {
    "macos-aarch64": "fc0f2818cb694e1abcc18f06a4bf049c090364e4b15441cc409b6a17a6c79509",
    "linux-x64": "78d0334f16fd399635e74575d214d009c950b536ecb4b4bc37fde1176775f43f",
    "linux-aarch64": "ccd0130761408a0154c9e7c3d2ea79f79689befa09f2bc2ee804744f17798954",
}

# One repository per platform and edition (graalvm_<os>_<cpu>, graalvm_ee_<os>_<cpu>), its toolchains constrained to that
# platform, so a client of any OS builds for remote Linux executors with their JDK. A repository is fetched only when a
# toolchain of its platform is selected.
GRAALVM_PLATFORMS = {
    "macos-aarch64": (
        "macos_aarch64",
        [
            "@platforms//os:macos",
            "@platforms//cpu:aarch64",
        ],
    ),
    "linux-x64": (
        "linux_amd64",
        [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ],
    ),
    "linux-aarch64": (
        "linux_aarch64",
        [
            "@platforms//os:linux",
            "@platforms//cpu:aarch64",
        ],
    ),
}

gvm = use_extension("@rules_graalvm//:extensions.bzl", "graalvm")

[gvm.graalvm(
    name = "graalvm_%s%s" % (edition_prefix, suffix),
    distribution = distribution,
    java_version = "25",
    platform = key,
    sha256s = {key: dists[key]},
    strip_prefixes = {key: "graalvm-%s-%s-%s" % (
        edition,
        GRAALVM,
        GRAALVM_ARCHIVES[key],
    )},
    target_compatible_with = constraints,
    toolchain_prefix = "graalvm" + ("_ee" if edition == "ee" else ""),
    urls = {key: "https://maven.elide.dev/gvm-elide/%s/dist/graalvm-%s-%s-%s.tar.gz" % (
        GRAALVM,
        edition,
        GRAALVM,
        GRAALVM_ARCHIVES[key],
    )},
    version = GRAALVM,
) for edition, edition_prefix, distribution, dists in [
    ("ce", "", "ce", GRAALVM_DISTS),
    ("ee", "ee_", "oracle", GRAALVM_EE_DISTS),
] for key, (suffix, constraints) in GRAALVM_PLATFORMS.items()]

use_repo(
    gvm,
    "graalvm_ee_linux_aarch64",
    "graalvm_ee_linux_aarch64_toolchains",
    "graalvm_ee_linux_amd64",
    "graalvm_ee_linux_amd64_toolchains",
    "graalvm_ee_macos_aarch64",
    "graalvm_ee_macos_aarch64_toolchains",
    "graalvm_linux_aarch64",
    "graalvm_linux_aarch64_toolchains",
    "graalvm_linux_amd64",
    "graalvm_linux_amd64_toolchains",
    "graalvm_macos_aarch64",
    "graalvm_macos_aarch64_toolchains",
)

register_toolchains(
    "//bazel/toolchains:all",
    "@graalvm_linux_amd64_toolchains//:all",
    "@graalvm_linux_aarch64_toolchains//:all",
    "@graalvm_macos_aarch64_toolchains//:all",
    "@graalvm_ee_linux_amd64_toolchains//:all",
    "@graalvm_ee_linux_aarch64_toolchains//:all",
    "@graalvm_ee_macos_aarch64_toolchains//:all",
)

